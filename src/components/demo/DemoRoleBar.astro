---
// A floating strip for showing VSAT to people who have no account.
//
// Two jobs: switch the viewing role (steward / author / signed out) without a
// login, and point out what is worth trying on the page you are looking at.
// Enabled only by DEMO_ROLE_BAR, which is unset on the production app, so this
// never renders for real users.
import { secondDemoAuthor } from "@authentication/demoRole";
import isStewardUser from "@authentication/isStewardUser";

const enabled =
  process.env.DEMO_ROLE_BAR === "1" || process.env.DEMO_ROLE_BAR === "true";

const user = Astro.locals.user;
const cookieHeader = Astro.request.headers.get("cookie");

const isSecondAuthor =
  user?.email?.toLowerCase() === secondDemoAuthor().email.toLowerCase();

const role = !user?.id
  ? "visitor"
  : isStewardUser(user, cookieHeader)
    ? "steward"
    : isSecondAuthor
      ? "author2"
      : "author1";

const roleLabel = {
  steward: "Steward",
  author1: "Author 1",
  author2: "Author 2",
  visitor: "Signed out",
}[role];

const whoami = user?.name ?? "not signed in";
---

{
  enabled && (
    <>
      <div class="demo-bar" data-role={role} id="vsat-demo-bar">
        <button
          class="demo-bar__grip"
          id="vsat-demo-bar-collapse"
          title="Hide the demo bar"
          aria-label="Hide the demo bar"
        >
          ▲
        </button>

        <div class="demo-bar__group demo-bar__group--roles">
          <span class="demo-bar__legend">View as</span>
          <button class="demo-bar__role" data-set-role="steward" type="button">
            Steward
          </button>
          <button class="demo-bar__role" data-set-role="author1" type="button">
            Author 1
          </button>
          <button class="demo-bar__role" data-set-role="author2" type="button">
            Author 2
          </button>
          <button class="demo-bar__role" data-set-role="visitor" type="button">
            Signed out
          </button>
        </div>

        <div class="demo-bar__group demo-bar__group--tour">
          <button class="demo-bar__tour-btn" id="vsat-demo-tour-prev" type="button" aria-label="Previous suggestion">
            ‹
          </button>
          <button class="demo-bar__tip" id="vsat-demo-tip" type="button">
            Start tour
          </button>
          <button class="demo-bar__next" id="vsat-demo-tour-next" type="button">
            Next ›
          </button>
        </div>

        <span class="demo-bar__who" title={`Acting as: ${whoami}`}>
          {roleLabel}
        </span>
      </div>

      <button class="demo-bar__restore" id="vsat-demo-bar-restore" hidden>
        Demo controls
      </button>

      <script is:inline define:vars={{ role }}>
        (() => {
          const bar = document.getElementById("vsat-demo-bar");
          const restore = document.getElementById("vsat-demo-bar-restore");
          const collapse = document.getElementById("vsat-demo-bar-collapse");
          if (!bar) return;

          // --- role switching -------------------------------------------------
          // `vsat_steward` is read by isStewardUser; `vsat_demo_anon` tells the
          // dev auth bypass to leave this request signed out.
          const setCookie = (name, value) => {
            document.cookie = `${name}=${value}; Path=/; SameSite=Lax`;
          };
          const clearCookie = (name) => {
            document.cookie = `${name}=; Path=/; Max-Age=0; SameSite=Lax`;
          };

          for (const button of bar.querySelectorAll("[data-set-role]")) {
            if (button.dataset.setRole === role) {
              button.classList.add("is-active");
              button.setAttribute("aria-current", "true");
            }

            button.addEventListener("click", () => {
              const next = button.dataset.setRole;
              if (next === "visitor") {
                setCookie("vsat_demo_anon", "1");
              } else {
                clearCookie("vsat_demo_anon");
                // Author 2 is a different account, so it is a different set of
                // stories; steward stays on author 1's account but sees all.
                setCookie("vsat_demo_author", next === "author2" ? "2" : "1");
                setCookie("vsat_steward", next === "steward" ? "1" : "0");
              }
              window.location.reload();
            });
          }

          // --- guided tour ----------------------------------------------------
          const path = window.location.pathname;
          const search = window.location.search;

          const planetarium =
            path.includes("/story/vsatlatarium") || search.includes("planetarium");
          const publishedStory = /^\/story\/\d+/.test(path);
          const dashboard = path.startsWith("/author");

          const tours = {
            planetarium: [
              "Drag to turn the sky — each glowing cluster is a story, its scenes orbiting it.",
              "Press ? for the full controls and verbs panel.",
              "Right-click a story — its scenes fan out as editable 3D cards.",
              "Click a card to read and edit the scene in place.",
              "⤳ connect in the popover, then click a target card, to draw a narrative arc.",
              "+ scene adds a new card; a teal frame means it has no connections yet.",
              "Toggle Surround to hear the story's audio positioned around you.",
              "🎙 Voice: arm it, then hold V and say 'new card called…' or 'focus…'.",
              "Switch between Author 1 and Author 2 above — each owns different stories, so the board changes with the role.",
              "Switch to Signed out to see exactly what a visitor with no account gets.",
            ],
            publishedStory: [
              "Drag inside the photosphere to look around the scene.",
              "Speaker icons are audio hotspots — placed in 3D, they get louder as you face them.",
              "Look at a hotspot to move toward it; the sound follows your gaze.",
              "Use the scene navigation to move through the story's pages.",
              "As an Author or Steward you can reposition hotspots; try Signed out to compare.",
            ],
            dashboard: [
              "These are the stories the current role can open and edit — the list changes with the role.",
              "Author 1 owns the bulk of the library, including the planetarium stories.",
              "Author 2 owns a different six — Riverside Walk, The Old Library, Market Day and the rest.",
              "Steward sees and curates everyone's work; an author sees only their own.",
              "Try it: open one of Author 2's stories, then switch to Author 1 — the same page is refused. Switch to Steward and it opens again.",
              "Open a story, then the planetarium view, to edit it in 3D.",
              "The steward console lists proposed links awaiting a decision.",
            ],
            generic: [
              "Use 'View as' on the left to switch role — the page reloads in that role.",
              "Author 1 and Author 2 are different accounts with different stories.",
              "Open the VSATLATARIUM to see every story as a constellation.",
              "Signed out shows what a visitor with no account can reach.",
            ],
          };

          const steps = planetarium
            ? tours.planetarium
            : publishedStory
              ? tours.publishedStory
              : dashboard
                ? tours.dashboard
                : tours.generic;

          const tip = document.getElementById("vsat-demo-tip");
          const prev = document.getElementById("vsat-demo-tour-prev");
          const next = document.getElementById("vsat-demo-tour-next");

          // Keep the reader's place across the reloads that a role switch causes.
          const KEY = "vsat-demo-tour-step";
          let index = Number(sessionStorage.getItem(KEY) ?? "-1");

          const render = () => {
            if (!tip) return;
            if (index < 0) {
              tip.textContent = `Start tour · ${steps.length} things to try`;
              tip.classList.remove("is-tip");
              return;
            }
            tip.textContent = `${index + 1}/${steps.length} · ${steps[index]}`;
            tip.classList.add("is-tip");
          };

          const renderNext = () => {
            if (!next) return;
            next.textContent =
              index < 0
                ? "Start ›"
                : index === steps.length - 1
                  ? "Finish ›"
                  : "Next ›";
          };

          // index runs -1 (idle, "Try this") then 0..steps.length-1, and wraps.
          const move = (delta) => {
            index += delta;
            if (index >= steps.length) index = -1;
            if (index < -1) index = steps.length - 1;
            sessionStorage.setItem(KEY, String(index));
            render();
            renderNext();
          };

          next?.addEventListener("click", () => move(1));
          prev?.addEventListener("click", () => move(-1));
          tip?.addEventListener("click", () => move(1));
          render();
          renderNext();

          // --- collapse -------------------------------------------------------
          const COLLAPSE_KEY = "vsat-demo-bar-hidden";
          const setHidden = (hidden) => {
            bar.hidden = hidden;
            if (restore) restore.hidden = !hidden;
            sessionStorage.setItem(COLLAPSE_KEY, hidden ? "1" : "0");
          };

          collapse?.addEventListener("click", () => setHidden(true));
          restore?.addEventListener("click", () => setHidden(false));
          setHidden(sessionStorage.getItem(COLLAPSE_KEY) === "1");
        })();
      </script>
    </>
  )
}

<style>
  .demo-bar {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100000;

    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: min(96vw, 1100px);
    padding: 0.35rem 0.6rem;

    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    color: #eaf2ff;

    background: rgba(10, 16, 28, 0.92);
    border: 1px solid #2f4a6d;
    border-top: none;
    border-radius: 0 0 0.6rem 0.6rem;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
  }

  .demo-bar__group {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .demo-bar__group--roles {
    padding-right: 0.6rem;
    border-right: 1px solid rgba(255, 255, 255, 0.18);
  }

  .demo-bar__legend {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.65rem;
    opacity: 0.7;
  }

  .demo-bar__role {
    padding: 0.2rem 0.6rem;
    font: inherit;
    color: #cfe0f5;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    cursor: pointer;
  }

  .demo-bar__role:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .demo-bar__role.is-active {
    color: #06121f;
    background: #7fc4ff;
    border-color: #7fc4ff;
    font-weight: 700;
  }

  .demo-bar__group--tour {
    flex: 1;
    min-width: 0;
  }

  /* The tip is a button, not a caption: it was being read as a label and the
     only "next" affordance was a chevron stranded at the far edge. */
  .demo-bar__tip {
    flex: 1;
    min-width: 0;
    padding: 0.3rem 0.5rem;
    font: inherit;
    text-align: left;
    color: inherit;
    background: transparent;
    border: none;
    border-bottom: 1px dotted rgba(255, 255, 255, 0.35);
    cursor: pointer;
    opacity: 0.85;
  }

  .demo-bar__tip.is-tip {
    opacity: 1;
    color: #ffe8a8;
    border-bottom-color: transparent;
  }

  .demo-bar__next {
    flex-shrink: 0;
    min-height: 2.1rem;
    padding: 0.3rem 0.85rem;
    font: inherit;
    font-weight: 700;
    white-space: nowrap;
    color: #06121f;
    background: #7fc4ff;
    border: 1px solid #7fc4ff;
    border-radius: 999px;
    cursor: pointer;
  }

  .demo-bar__next:hover {
    background: #a4d6ff;
  }

  .demo-bar__tour-btn {
    padding: 0.1rem 0.45rem;
    font: inherit;
    font-size: 1rem;
    line-height: 1;
    color: #cfe0f5;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 0.3rem;
    cursor: pointer;
  }

  .demo-bar__tour-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .demo-bar__who {
    padding: 0.15rem 0.5rem;
    font-size: 0.7rem;
    white-space: nowrap;
    border-radius: 0.3rem;
    background: rgba(255, 255, 255, 0.1);
  }

  .demo-bar__grip {
    padding: 0.1rem 0.35rem;
    font: inherit;
    font-size: 0.7rem;
    color: #cfe0f5;
    background: transparent;
    border: none;
    cursor: pointer;
    opacity: 0.6;
  }

  .demo-bar__grip:hover {
    opacity: 1;
  }

  .demo-bar__restore {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100000;

    padding: 0.15rem 0.7rem;
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    color: #eaf2ff;
    background: rgba(10, 16, 28, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-top: none;
    border-radius: 0 0 0.5rem 0.5rem;
    cursor: pointer;
  }

  @media (max-width: 720px) {
    .demo-bar {
      flex-wrap: wrap;
      gap: 0.4rem;
      font-size: 0.72rem;
    }

    .demo-bar__group--roles {
      border-right: none;
    }

    .demo-bar__who {
      display: none;
    }

    /* Give the tour its own row so Next sits beside the text it advances,
       and make every control big enough to hit with a thumb. */
    .demo-bar__group--tour {
      width: 100%;
    }

    .demo-bar__next {
      min-height: 2.4rem;
      padding: 0.4rem 1rem;
    }

    .demo-bar__tour-btn {
      min-width: 2.2rem;
      min-height: 2.4rem;
    }

    .demo-bar__role {
      min-height: 2.2rem;
    }
  }
</style>
