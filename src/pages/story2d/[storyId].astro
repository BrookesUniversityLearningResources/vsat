---
// The 2D demo route has folded into /story/[storyId] (per-story `mode` +
// ?view= override). Old links — including QR-coded ?room= links — keep
// working via this redirect.
const params = new URLSearchParams(Astro.url.search);
if (!params.has("view")) {
  params.set("view", "flat");
}
return Astro.redirect(
  `/story/${Astro.params.storyId}?${params.toString()}`,
  301,
);
---
