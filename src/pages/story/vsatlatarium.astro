  <script
    is:inline
    define:vars={{
      clientData,
      geomViewCameraDefaultZ,
      geomViewCameraMinZ,
      geomViewCameraMaxZ,
    }}
  >
    // --- Turntable controls (rotate the world, camera stays fixed) ---
    const canvas = document.querySelector(".vsatlatarium__canvas");
    const sceneEl = document.querySelector("a-scene");
    const turntable = document.getElementById("vsat-turntable");
    const { isPlanetarium } = clientData;
    window.vsatlatariumClientData = clientData;

    // Trackball-style rotation: a quaternion accumulator on the
    // turntable lets the user rotate the world around any screen-space
    // axis, no Euler-clamp at ±85° pitch and no missing roll. Drags
    // are pre-multiplied so the rotation axes stay camera-fixed (the
    // "sphere supported by water" feel).
    const turntableQuat = new THREE.Quaternion();
    let camZ = isPlanetarium ? 0 : geomViewCameraDefaultZ; // camera distance along Z
    const camZDefault = camZ;
    const camZMin = isPlanetarium
      ? -(clientData.clusterRadius * 0.8)
      : geomViewCameraMinZ;
    // In planetarium mode, allow scrolling back past origin for a
    // "sky disk" overview, but cap the camera just inside the visible
    // dome shell so the user never pops out into a globe-from-outside
    // view of the constellation.
    const camZMax = isPlanetarium
      ? clientData.domeShellRadius - 4
      : geomViewCameraMaxZ;
    let isDragging = false;
    let dragTotal = 0;
    let lastMouse = { x: 0, y: 0 };

    // In planetarium mode, drag direction is inverted (you're inside the sphere).
    const dragSign = isPlanetarium ? -1 : 1;
    // Radians of rotation per pixel of drag.
    const dragAngleScale = isPlanetarium ? 0.005 : 0.008;

    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

    const camRig = document.getElementById("vsat-cam-rig");

    const applyTransform = () => {
      if (!turntable) return;
      if (turntable.object3D) {
        turntable.object3D.quaternion.copy(turntableQuat);
      }
      // Move camera rig along Z axis (toward/away from dome)
      if (camRig) {
        camRig.setAttribute("position", `0 0 ${camZ}`);
      }
      updateGeomViewLabelMode();
    };

    let geomViewSceneLabelsVisible = true;
    // While a story is focused into cards (enterFocus3D), the dolly-in
    // brings the camera close enough that the distance heuristic below
    // would re-reveal this cluster's scene labels — and they'd peek
    // through behind the cards. Pin them hidden until focus exits.
    let sceneLabelsPinnedHidden = false;
    const updateGeomViewLabelMode = () => {
      if (!camRig?.object3D) return;
      if (sceneLabelsPinnedHidden) {
        document.querySelectorAll(".scene-label").forEach((label) => {
          label.setAttribute("visible", "false");
        });
        return;
      }

      let revealBelow;
      let hideAbove;
      if (isPlanetarium) {
        // Sky-disk territory: once camZ has pulled past the cluster
        // envelope, scene labels start to pile up. Hide them; story
        // names alone read fine.
        const camDist = camZ;
        revealBelow = clientData.clusterRadius * 0.85;
        hideAbove = clientData.clusterRadius * 1.0;
        if (geomViewSceneLabelsVisible) {
          if (camDist >= hideAbove) geomViewSceneLabelsVisible = false;
        } else if (camDist <= revealBelow) {
          geomViewSceneLabelsVisible = true;
        }
      } else {
        const camDist = camRig.object3D.position.length();
        revealBelow = clientData.geomViewStoryEnvelopeRadius + 3;
        hideAbove = clientData.geomViewStoryEnvelopeRadius + 6;
        if (geomViewSceneLabelsVisible) {
          if (camDist >= hideAbove) geomViewSceneLabelsVisible = false;
        } else if (camDist <= revealBelow) {
          geomViewSceneLabelsVisible = true;
        }
      }

      document.querySelectorAll(".scene-label").forEach((label) => {
        label.setAttribute("visible", geomViewSceneLabelsVisible ? "true" : "false");
      });
    };

    canvas.addEventListener("mousedown", (e) => {
      isDragging = true;
      dragTotal = 0;
      lastMouse = { x: e.clientX, y: e.clientY };
      highlightNode(null);
      hoveredNode = null;
    });

    canvas.addEventListener("contextmenu", (e) => e.preventDefault());

    // Reusable buffers so we don't allocate on every mousemove tick.
    const _dragAxis = new THREE.Vector3();
    const _dragDelta = new THREE.Quaternion();

    window.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      const dx = e.clientX - lastMouse.x;
      const dy = e.clientY - lastMouse.y;
      dragTotal += Math.abs(dx) + Math.abs(dy);
      lastMouse = { x: e.clientX, y: e.clientY };
      const len = Math.hypot(dx, dy);
      if (len < 0.01) return;
      // Rotation axis is perpendicular to the drag in screen space:
      // horizontal drag → camera-up axis (yaw), vertical drag →
      // camera-right axis (pitch). Diagonal drags rotate around an
      // intermediate axis, which is what gives the trackball feel.
      _dragAxis.set(dy, dx, 0).normalize();
      const angle = len * dragAngleScale * dragSign;
      _dragDelta.setFromAxisAngle(_dragAxis, angle);
      // Pre-multiply: the new rotation is applied in the camera frame,
      // so the axes don't drift as the world rotates underneath.
      turntableQuat.premultiply(_dragDelta).normalize();
      applyTransform();
    });

    window.addEventListener("mouseup", () => { isDragging = false; });

    // Render all arcs in arcDefs at a given blend, replacing any
    // existing segments. Used by both the zoom-blend redraw and the
    // hot-add path (force redraw at currentBlend after appending a
    // new def).
    const renderArcsAtBlend = (blend) => {
      if (!isPlanetarium || arcDefs.length === 0) return;
      turntable.querySelectorAll(".arc-segment").forEach((el) => el.remove());
      const blendedRadius = domeRadius * (1 - blend);
      for (const def of arcDefs) {
        const { from, to, controlPoint, color, opacity, radius, arcType } = def;
        if (hiddenArcTypes.has(arcType)) continue;
        for (let i = 0; i < segments; i++) {
          const t0 = i / segments;
          const t1 = (i + 1) / segments;
          let p0 = bezierPoint(from, controlPoint, to, t0);
          let p1 = bezierPoint(from, controlPoint, to, t1);
          if (blendedRadius > 0.1) {
            p0 = projectToDome(p0, blendedRadius);
            p1 = projectToDome(p1, blendedRadius);
          }
          const mx = (p0.x + p1.x) / 2;
          const my = (p0.y + p1.y) / 2;
          const mz = (p0.z + p1.z) / 2;
          const dx = p1.x - p0.x;
          const dy = p1.y - p0.y;
          const dz = p1.z - p0.z;
          const len = Math.sqrt(dx * dx + dy * dy + dz * dz);
          if (len < 0.001) continue;

          const el = document.createElement("a-entity");
          el.setAttribute("position", mx + " " + my + " " + mz);
          el.setAttribute("geometry", "primitive: cylinder; radius: " + radius + "; height: " + len + "; segmentsRadial: 4; openEnded: true");
          el.setAttribute("material", "color: " + color + "; opacity: " + opacity + "; transparent: true; shader: flat");
          const dir = new THREE.Vector3(dx, dy, dz).normalize();
          const quat = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir);
          el.object3D.quaternion.copy(quat);
          el.classList.add("arc-segment");
          if (arcType) el.setAttribute("data-arc-type", arcType);
          turntable.appendChild(el);
        }
      }
    };

    // Zoom-blend redraw: short-circuits if the blend hasn't changed.
    const redrawArcsAtBlend = (blend) => {
      if (blend === currentBlend) return;
      currentBlend = blend;
      renderArcsAtBlend(blend);
    };

    // Force a full re-render at the current blend (used after the
    // hot-add path appends a new arcDef).
    const refreshArcs = () => {
      renderArcsAtBlend(currentBlend);
    };

    // Debounce the redraw so rapid scrolling doesn't thrash the DOM
    let arcRedrawTimer = null;
    const scheduleArcRedraw = () => {
      if (!isPlanetarium) return;
      const blend = camZ <= 0 ? 0 : Math.min(camZ / (clientData.clusterRadius * 0.8), 1);
      // Quantize to avoid redraws on tiny changes
      const quantized = Math.round(blend * 20) / 20;
      if (quantized === currentBlend) return;
      if (arcRedrawTimer) clearTimeout(arcRedrawTimer);
      arcRedrawTimer = setTimeout(() => redrawArcsAtBlend(quantized), 80);
    };

    canvas.addEventListener("wheel", (e) => {
      e.preventDefault();
      camZ = clamp(camZ - e.deltaY * 0.03, camZMin, camZMax);
      applyTransform();
      scheduleArcRedraw();
      // Update highlight ring position after zoom
      if (hoveredNode) highlightNode(hoveredNode);
    }, { passive: false });

    // Reset button
    // Phone handoff: QR of the CURRENT view (anthology + view params) — scan,
    // open on the phone, then tap A-Frame's goggles button for Cardboard.
    document.getElementById("vsat-qr")?.addEventListener("click", async () => {
      const existing = document.querySelector(".vsat-qr-overlay");
      if (existing) { existing.remove(); return; }
      const overlay = document.createElement("div");
      overlay.className = "vsat-qr-overlay";
      overlay.style.cssText = "position:fixed;inset:0;z-index:10005;display:grid;place-items:center;background:rgba(5,7,12,0.85);cursor:pointer";
      const panel = document.createElement("div");
      panel.style.cssText = "display:grid;gap:0.7rem;justify-items:center;padding:1.2rem 1.4rem;border-radius:1rem;background:#12151b;border:1px solid rgba(150,170,190,0.35);color:#ecf0f1;font-family:'Source Sans Pro',system-ui,sans-serif";
      const qrCanvas = document.createElement("canvas");
      const caption = document.createElement("p");
      caption.style.cssText = "margin:0;max-width:20rem;text-align:center;font-size:0.85rem;color:#9fb3c8";
      caption.textContent = "Scan to open this view on a phone — then tap the goggles button (bottom right) and slot it into the Cardboard wrapper.";
      panel.append(qrCanvas, caption);
      overlay.appendChild(panel);
      overlay.addEventListener("click", () => overlay.remove());
      document.body.appendChild(overlay);
      try {
        await window.__vsatQR.toCanvas(qrCanvas, window.location.href, {
          width: 280,
          margin: 2,
          color: { dark: "#0e1014", light: "#ecf0f1" },
        });
      } catch (err) {
        caption.textContent = "Couldn't render the QR: " + ((err && err.message) || err);
      }
    });

    document.getElementById("vsat-reset-cam")?.addEventListener("click", () => {
      turntableQuat.identity();
      camZ = camZDefault;
      applyTransform();
    });

    // --- Planetarium surround prototype: one quiet positional emitter per
    // story with audio, placed at the story cluster's dome direction. State
    // is deliberately session-only and defaults off.
    let surroundEnabled = false;
    const surroundBtn = document.getElementById("vsat-toggle-surround");
    const removeSurroundEmitters = () => {
      turntable?.querySelectorAll(".vsat-surround-emitter").forEach((emitter) => {
        emitter.components?.sound?.stopSound?.();
        emitter.remove();
      });
    };
    const addSurroundEmitters = () => {
      if (!isPlanetarium || !turntable) return;
      for (const cluster of clientData.clusters) {
        if (!cluster.audioUrl) continue;
        const emitter = document.createElement("a-entity");
        emitter.classList.add("vsat-surround-emitter");
        emitter.dataset.storyId = String(cluster.storyId);
        emitter.setAttribute(
          "position",
          `${cluster.center.x} ${cluster.center.y} ${cluster.center.z}`,
        );
        emitter.setAttribute(
          "sound",
          `src: ${cluster.audioUrl}; positional: true; autoplay: true; loop: true; volume: 0.4; refDistance: ${clientData.clusterRadius}; rolloffFactor: 0.15`,
        );
        turntable.appendChild(emitter);
      }
    };
    surroundBtn?.addEventListener("click", () => {
      const audioContext = AFRAME.THREE.AudioContext.getContext();
      if (audioContext.state === "suspended") {
        void audioContext.resume().catch(() => undefined);
      }
      surroundEnabled = !surroundEnabled;
      removeSurroundEmitters();
      if (surroundEnabled) addSurroundEmitters();
      surroundBtn.classList.toggle(
        "vsatlatarium__btn--active",
        surroundEnabled,
      );
      surroundBtn.setAttribute("aria-pressed", String(surroundEnabled));
    });

    // --- Vapor slider — controls pink glow via Three.js material directly ---
    const vaporSlider = document.getElementById("vsat-vapor-slider");
    const initVaporSlider = () => {
      if (!vaporSlider) return;
      const vaporEl = document.getElementById("vsat-vapor");
      if (!vaporEl) return;

      vaporSlider.addEventListener("input", () => {
        const v = Number(vaporSlider.value) / 100;

        // Pink dome glow
        vaporEl.object3D.traverse((child) => {
          if (child.material) {
            child.material.opacity = v * 0.7;
            child.material.emissiveIntensity = v * 4.0;
            child.material.needsUpdate = true;
          }
        });

        // Boost arc tubes — increase opacity and brighten color toward white
        document.querySelectorAll(".arc-segment").forEach((el) => {
          if (!el.object3D) return;
          el.object3D.traverse((child) => {
            if (!child.material) return;
            if (child.userData._baseOpacity === undefined) {
              child.userData._baseOpacity = child.material.opacity;
              child.userData._baseColor = child.material.color.clone();
            }
            child.material.opacity = Math.min(child.userData._baseOpacity + v * 0.5, 1);
            // Slight brighten — keep saturation, just lighten
            child.material.color.copy(child.userData._baseColor).lerp(new THREE.Color(0xffffff), v * 0.15);
            child.material.needsUpdate = true;
            // Bloom — fatten the tubes
            if (child.userData._baseScaleX === undefined) {
              child.userData._baseScaleX = child.scale.x;
              child.userData._baseScaleZ = child.scale.z;
            }
            const bloom = 1 + v * 3;
            child.scale.x = child.userData._baseScaleX * bloom;
            child.scale.z = child.userData._baseScaleZ * bloom;
          });
        });

        // Shift scene background toward pink
        if (sceneEl) {
          const r = Math.round(3 + v * 30);
          const g = Math.round(3 + v * 5);
          const b = Math.round(8 + v * 25);
          sceneEl.setAttribute("background", "color: #" +
            r.toString(16).padStart(2, "0") +
            g.toString(16).padStart(2, "0") +
            b.toString(16).padStart(2, "0"));
        }

        // Brighten hover ring with vapor — para-selene halo effect
        vaporLevel = v;
        if (hlRingMat) {
          hlRingMat.opacity = 0.6 + v * 0.4;
          hlRingMat.color.lerpColors(
            new THREE.Color(0xfbbf24),
            new THREE.Color(0xffeebb),
            v,
          );
        }
        if (hlGlowMat) {
          hlGlowMat.opacity = 0.08 + v * 0.5;
          hlGlowMat.color.lerpColors(
            new THREE.Color(0xfbbf24),
            new THREE.Color(0xffddaa),
            v,
          );
        }
        // Scale up the glow disc at high vapor
        if (hlGlow) {
          const glowScale = 1 + v * 1.5;
          hlGlow.scale.setScalar(hlGlow.userData._baseScale ?? 1);
          hlGlow.scale.multiplyScalar(glowScale);
        }

        // Particle dust
        ensureParticles();
        if (particleMat) {
          particleMat.opacity = v * 0.35;
          particleMat.size = 0.06 + v * 0.15;
          particleMat.color.setHex(v > 0.6 ? 0xffaacc : 0xffc0dd);
        }

        // Visual feedback on the slider — fill to the left of the thumb
        const pct = vaporSlider.value;
        vaporSlider.style.background =
          `linear-gradient(90deg, #ff69b4 0%, #ff69b4 ${pct}%, #1a1a3a ${pct}%, #1a1a3a 100%)`;
        const pinkGlow = `rgba(255, 105, 180, ${(v * 0.3).toFixed(2)})`;
        vaporSlider.style.boxShadow = v > 0.05
          ? `0 0 ${Math.round(v * 10)}px ${Math.round(v * 4)}px ${pinkGlow}`
          : "none";
      });

      // Fire once to set initial glow on the slider
      vaporSlider.dispatchEvent(new Event("input"));
    };
    if (sceneEl.hasLoaded) initVaporSlider();
    else sceneEl.addEventListener("loaded", () => setTimeout(initVaporSlider, 200));

    // --- Wireframe toggle ---
    let wireframesVisible = false;
    const wireframeBtn = document.getElementById("vsat-toggle-wireframes");
    wireframeBtn?.addEventListener("click", () => {
      wireframesVisible = !wireframesVisible;
      document.querySelectorAll(".cluster-wireframe, .dome-wireframe").forEach((el) => {
        el.setAttribute("visible", wireframesVisible);
      });
      wireframeBtn.classList.toggle("vsatlatarium__btn--active", wireframesVisible);
    });

    // --- In-app usage note ("?" in the toolbar): the authoring verbs are
    // gesture-driven and otherwise invisible — this panel is where a new
    // user finds out they exist. Registered BEFORE initInteraction's
    // keydown, so an open help panel swallows Esc instead of also
    // collapsing an open focus board.
    const helpBtn = document.getElementById("vsat-help");
    const helpPanel = document.getElementById("vsat-help-panel");
    const setHelpVisible = (show) => {
      if (!helpPanel) return;
      helpPanel.hidden = !show;
      helpBtn?.classList.toggle("vsatlatarium__btn--active", show);
    };
    helpBtn?.addEventListener("click", () => setHelpVisible(helpPanel.hidden));
    window.addEventListener("keydown", (e) => {
      const typing = e.target instanceof Element &&
        (e.target.closest("input, textarea, [contenteditable]") !== null);
      if (typing) return;
      if (e.key === "?") setHelpVisible(helpPanel?.hidden);
      if (e.key === "Escape" && helpPanel && !helpPanel.hidden) {
        setHelpVisible(false);
        e.stopImmediatePropagation();
      }
    });

    // --- Debug: number + colour-code every arc for precise bug reports ---
    let arcIdsVisible = false;
    const arcLabelEls = [];
    const arcIdBtn = document.getElementById("vsat-toggle-arcids");
    arcIdBtn?.addEventListener("click", () => {
      arcIdsVisible = !arcIdsVisible;
      arcIdBtn.classList.toggle("vsatlatarium__btn--active", arcIdsVisible);

      if (arcIdsVisible) {
        // Give each arc its own colour so crossings are easy to trace.
        document.querySelectorAll(".arc-segment[data-arc-uid]").forEach((el) => {
          const uid = Number(el.getAttribute("data-arc-uid"));
          el.setAttribute(
            "material",
            "color: " + arcDebugColor(uid) + "; opacity: 0.95; transparent: true; shader: flat",
          );
        });
        // Drop a billboarded number at each arc's midpoint.
        for (const a of debugArcs) {
          const el = document.createElement("a-troika-text");
          el.setAttribute(
            "troika-text",
            "value: " + a.uid + "; align: center; color: " + arcDebugColor(a.uid, 80) +
              "; fontSize: 0.55; outlineWidth: 0.045; outlineColor: #000000; outlineOpacity: 0.95",
          );
          el.setAttribute("position", a.mid.x + " " + a.mid.y + " " + a.mid.z);
          el.setAttribute("stabilcam", "baseScale: 0.9; refDist: 24; maxScale: 1.1; occlude: true");
          el.classList.add("arc-debug-label");
          turntable.appendChild(el);
          arcLabelEls.push(el);
        }
      } else {
        // Restore each segment's original type colour and remove labels.
        document.querySelectorAll(".arc-segment[data-arc-uid]").forEach((el) => {
          el.setAttribute(
            "material",
            "color: " + el.getAttribute("data-arc-color") +
              "; opacity: " + el.getAttribute("data-arc-opacity") +
              "; transparent: true; shader: flat",
          );
        });
        for (const el of arcLabelEls) el.remove();
        arcLabelEls.length = 0;
      }
    });

    // --- Legend arc type toggles ---
    const hiddenArcTypes = new Set();
    document.querySelectorAll(".legend-toggle").forEach((li) => {
      li.addEventListener("click", () => {
        const type = li.getAttribute("data-arc-type");
        if (!type) return;
        const isOff = hiddenArcTypes.has(type);
        if (isOff) {
          hiddenArcTypes.delete(type);
        } else {
          hiddenArcTypes.add(type);
        }
        li.classList.toggle("legend-toggle--off", !isOff);
        // Show/hide matching arc segments
        document.querySelectorAll('.arc-segment[data-arc-type="' + type + '"]').forEach((el) => {
          el.setAttribute("visible", isOff ? "true" : "false");
        });
      });
    });

    // --- Build 3D Bezier arcs as line segments ---
    const bezierPoint = (a, cp, b, t) => ({
      x: (1 - t) * (1 - t) * a.x + 2 * (1 - t) * t * cp.x + t * t * b.x,
      y: (1 - t) * (1 - t) * a.y + 2 * (1 - t) * t * cp.y + t * t * b.y,
      z: (1 - t) * (1 - t) * a.z + 2 * (1 - t) * t * cp.z + t * t * b.z,
    });

    const midpoint = (a, b) => ({
      x: (a.x + b.x) / 2,
      y: (a.y + b.y) / 2,
      z: (a.z + b.z) / 2,
    });

    const length3 = (v) => Math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z);

    const normalize3 = (v) => {
      const len = length3(v) || 1;
      return { x: v.x / len, y: v.y / len, z: v.z / len };
    };

    const linkTypeColors = {
      thematic: "#c084fc",  // purple
      causal: "#ef4444",    // red
      adjacency: "#34d399", // green
      contrast: "#f472b6",  // pink
    };

    const arcVisualForLink = (arc) => {
      const color = linkTypeColors[arc.linkType] ?? "#7286ff";
      const opacity =
        arc.status === "retired" ? 0.15 :
        arc.status === "accepted" ? 0.8 :
        arc.status === "rejected" ? 0.2 : 0.5;
      const bowFactor = isPlanetarium
        ? (arc.status === "accepted" ? 0.5 : 0.3)
        : (arc.status === "accepted" ? 3.5 : 2.5);
      return { color, opacity, bowFactor };
    };

    // For inter-story arcs: in planetarium mode bow inward (toward viewer),
    // in geomview mode bow outward (away from origin)
    const arcControlPoint = (a, b, bowFactor) => {
      const mid = midpoint(a, b);
      const dir = normalize3(mid);
      const sign = isPlanetarium ? -1 : 1;
      return {
        x: mid.x + dir.x * bowFactor * sign,
        y: mid.y + dir.y * bowFactor * sign,
        z: mid.z + dir.z * bowFactor * sign,
      };
    };

    const localArcControlPoint = (a, b, clusterCenter, bowFactor) => {
      const mid = midpoint(a, b);
      const toMid = {
        x: mid.x - clusterCenter.x,
        y: mid.y - clusterCenter.y,
        z: mid.z - clusterCenter.z,
      };
      const dir = normalize3(toMid);
      return {
        x: mid.x + dir.x * bowFactor,
        y: mid.y + dir.y * bowFactor,
        z: mid.z + dir.z * bowFactor,
      };
    };

    const segments = 24;
    const domeRadius = isPlanetarium ? clientData.clusterRadius : 0;

    // Project a point onto a sphere of given radius (for dome projection)
    const projectToDome = (p, radius) => {
      if (!radius) return p;
      const len = Math.sqrt(p.x * p.x + p.y * p.y + p.z * p.z) || 1;
      return {
        x: (p.x / len) * radius,
        y: (p.y / len) * radius,
        z: (p.z / len) * radius,
      };
    };

    // Arc definitions stored for redraw at different dome projection radii
    const arcDefs = [];
    let currentBlend = 0;

    // Narrative-arc identity: data-arc-uid → { from, to, storyId } node ids,
    // recorded wherever an internal arc is drawn. This is what lets the
    // focus board's REMOVE verb map a hovered arc back to the content line
    // that created it. Scene→hub tether arcs (drawn for unconnected
    // scenes) have no content line behind them, so they are excluded and
    // tracked separately for cleanup on scene delete.
    const internalArcByUid = new Map();
    const hubArcUidByScene = new Map();

    // Debug "Arc IDs" mode: every arc gets a unique sequential number and a
    // distinct colour so a specific arc can be named in a bug report. Built up
    // as arcs are drawn, consumed by the #vsat-toggle-arcids handler below.
    let arcUid = 0;
    const debugArcs = [];
    // Distinct colour per arc via the golden angle — adjacent uids never
    // collide in hue. Returns an hsl() string (THREE.Color parses it).
    const arcDebugColor = (uid, light) =>
      "hsl(" + Math.round((uid * 137.508) % 360) + ",85%," + (light || 60) + "%)";

    const drawArc = (from, to, controlPoint, color, opacity, thickness, arcType, arcId, storyId) => {
      const radius = thickness || 0.04;
      // Store definition for later redraw on zoom
      if (domeRadius) {
        arcDefs.push({ from, to, controlPoint, color, opacity, radius, arcType, arcId, storyId });
      }
      // Reserve this arc's debug id and record its midpoint for the label.
      const uid = arcUid++;
      let mid = bezierPoint(from, controlPoint, to, 0.5);
      if (domeRadius) mid = projectToDome(mid, domeRadius);
      debugArcs.push({ uid, mid, arcType, storyId });
      for (let i = 0; i < segments; i++) {
        const t0 = i / segments;
        const t1 = (i + 1) / segments;
        let p0 = bezierPoint(from, controlPoint, to, t0);
        let p1 = bezierPoint(from, controlPoint, to, t1);
        if (domeRadius) {
          p0 = projectToDome(p0, domeRadius);
          p1 = projectToDome(p1, domeRadius);
        }
        const mx = (p0.x + p1.x) / 2;
        const my = (p0.y + p1.y) / 2;
        const mz = (p0.z + p1.z) / 2;
        const dx = p1.x - p0.x;
        const dy = p1.y - p0.y;
        const dz = p1.z - p0.z;
        const len = Math.sqrt(dx * dx + dy * dy + dz * dz);
        if (len < 0.001) continue;

        const el = document.createElement("a-entity");
        el.setAttribute("position", mx + " " + my + " " + mz);
        el.setAttribute("geometry", "primitive: cylinder; radius: " + radius + "; height: " + len + "; segmentsRadial: 4; openEnded: true");
        el.setAttribute("material", "color: " + color + "; opacity: " + opacity + "; transparent: true; shader: flat");

        const dir = new THREE.Vector3(dx, dy, dz).normalize();
        const up = new THREE.Vector3(0, 1, 0);
        const quat = new THREE.Quaternion().setFromUnitVectors(up, dir);
        el.object3D.quaternion.copy(quat);

        el.classList.add("arc-segment");
        el.setAttribute("data-arc-uid", String(uid));
        el.setAttribute("data-arc-color", color);
        el.setAttribute("data-arc-opacity", String(opacity));
        if (arcType) el.setAttribute("data-arc-type", arcType);
        if (arcId !== undefined && arcId !== null) {
          el.setAttribute("data-arc-id", String(arcId));
        }
        if (storyId !== undefined && storyId !== null) {
          el.setAttribute("data-story-id", String(storyId));
        }
        turntable.appendChild(el);
      }
      return uid;
    };

    // Wait for scene to be loaded, then draw arcs
    const onReady = () => {
      const { clusters, interArcs } = clientData;

      // Internal narrative arcs (within each story cluster) — orange like StoryOverview
      for (const cluster of clusters) {
        const nodeMap = new Map(cluster.scenes.map((s) => [s.id, s.position]));
        // Include the story hub node so arcs can target it
        nodeMap.set(cluster.storyNodeId, cluster.storyNodePos);
        for (const arc of cluster.internalArcs) {
          const from = nodeMap.get(arc.from);
          const to = nodeMap.get(arc.to);
          if (!from || !to) continue;
          const internalBow = isPlanetarium ? 0.15 : 1.2;
          const cp = localArcControlPoint(from, to, cluster.center, internalBow);
          const uid = drawArc(from, to, cp, "#fb923c", 0.8, 0.06, "internal", undefined, cluster.storyId);
          if (arc.from === cluster.storyNodeId || arc.to === cluster.storyNodeId) {
            hubArcUidByScene.set(arc.from === cluster.storyNodeId ? arc.to : arc.from, uid);
          } else {
            internalArcByUid.set(uid, { from: arc.from, to: arc.to, storyId: String(cluster.storyId) });
          }
        }
      }

      for (const arc of interArcs) {
        const { color, opacity, bowFactor } = arcVisualForLink(arc);
        const cp = arcControlPoint(arc.fromPos, arc.toPos, bowFactor);
        drawArc(arc.fromPos, arc.toPos, cp, color, opacity, 0.05, arc.linkType, arc.id);
      }
    };

    if (sceneEl.hasLoaded) {
      onReady();
    } else {
      sceneEl.addEventListener("loaded", onReady);
    }

    // --- Screen-space proximity hover/click ---
    const infoEl = document.getElementById("vsat-info");
    const { interArcs: arcData } = clientData;

    const arcsByStory = new Map();
    const arcMetaById = new Map();
    for (const arc of arcData) {
      arcMetaById.set(arc.id, arc);
      for (const title of [arc.fromStoryTitle, arc.toStoryTitle]) {
        if (!arcsByStory.has(title)) arcsByStory.set(title, []);
        arcsByStory.get(title).push(arc);
      }
    }

    let hoveredNode = null;
    let prevHighlightSphere = null;
    const hoverRadiusPx = 100; // generous — story titles can be wide
    const sceneNodeEls = [];
    // Each entry: { el, targets: [object3D, ...] } — node + text label positions
    const hoverEntries = [];

    const collectNodes = () => {
      sceneNodeEls.length = 0;
      hoverEntries.length = 0;
      document.querySelectorAll(".scene-node").forEach((el) => {
        if (el.object3D) {
          sceneNodeEls.push(el);
          const targets = [el.object3D];
          // Include text label positions as additional hover targets
          el.querySelectorAll("[troika-text], a-text").forEach((txt) => {
            if (txt.object3D) targets.push(txt.object3D);
          });
          hoverEntries.push({ el, targets });
        }
      });

      // Story title text is a sibling of the hub node inside .story-cluster.
      // Associate it with the hub node so hovering the title highlights the hub.
      document.querySelectorAll(".story-cluster").forEach((cluster) => {
        const hubNode = cluster.querySelector(".scene-node");
        if (!hubNode) return;
        const entry = hoverEntries.find((e) => e.el === hubNode);
        if (!entry) return;
        // Find direct child text that isn't inside a scene-node
        for (const child of cluster.children) {
          if (child.classList?.contains("scene-node")) continue;
          if (child.hasAttribute("troika-text") || child.tagName === "A-TEXT") {
            if (child.object3D) entry.targets.push(child.object3D);
          }
        }
      });
    };

    // collectNodes + attachInteraction are called together below

    const _worldPos = new THREE.Vector3();
    const _projected = new THREE.Vector3();

    const findNearest = (clientX, clientY) => {
      const aCanvas = sceneEl.canvas;
      if (!aCanvas || !sceneEl.camera) return null;
      const rect = aCanvas.getBoundingClientRect();
      const mx = clientX - rect.left;
      const my = clientY - rect.top;
      const hw = rect.width / 2;
      const hh = rect.height / 2;
      const cam = sceneEl.camera;

      let best = null;
      let bestDist = hoverRadiusPx;

      for (const entry of hoverEntries) {
        // Check all targets (node position + text positions)
        for (const obj of entry.targets) {
          obj.getWorldPosition(_worldPos);
          _projected.copy(_worldPos).project(cam);
          if (_projected.z > 1) continue;
          const sx = (_projected.x + 1) * hw;
          const sy = (-_projected.y + 1) * hh;
          const dist = Math.sqrt((mx - sx) ** 2 + (my - sy) ** 2);
          if (dist < bestDist) {
            bestDist = dist;
            best = entry.el;
          }
        }
      }
      return best;
    };

    // Find the nearest inter-story arc segment to the cursor in
    // screen space. Returns the arc-id of the closest arc within
    // arcHoverRadiusPx, or null. We measure the proper point-to-
    // line-segment distance in screen space (each cylinder segment
    // is oriented along its local Y axis, so the world endpoints
    // are midpoint ± height/2 * worldDir).
    const arcHoverRadiusPx = 18;
    const _segP0 = new THREE.Vector3();
    const _segP1 = new THREE.Vector3();
    const _segDir = new THREE.Vector3();
    const _segUp = new THREE.Vector3(0, 1, 0);
    const findNearestArc = (clientX, clientY) => {
      const aCanvas = sceneEl.canvas;
      if (!aCanvas || !sceneEl.camera || !turntable) return null;
      const rect = aCanvas.getBoundingClientRect();
      const mx = clientX - rect.left;
      const my = clientY - rect.top;
      const hw = rect.width / 2;
      const hh = rect.height / 2;
      const cam = sceneEl.camera;

      let bestId = null;
      let bestDist = arcHoverRadiusPx;
      const segments = turntable.querySelectorAll(".arc-segment[data-arc-id]");
      for (const seg of segments) {
        if (!seg.object3D) continue;
        if (seg.getAttribute("data-arc-type") === "internal") continue;
        // Read the cylinder's height from its geometry component.
        // A-Frame returns parsed component data here, not the raw
        // string we set, so we read .height directly.
        const geomAttr = seg.getAttribute("geometry");
        const height = typeof geomAttr === "object" && geomAttr
          ? Number(geomAttr.height) || 0
          : (typeof geomAttr === "string"
              ? parseFloat((geomAttr.match(/height:\s*([0-9.]+)/) || [])[1] || "0")
              : 0);
        if (!height) continue;
        // World endpoints: midpoint ± dir * height/2
        seg.object3D.getWorldPosition(_segP0);
        _segDir.copy(_segUp).applyQuaternion(seg.object3D.getWorldQuaternion(new THREE.Quaternion()));
        _segP1.copy(_segP0).addScaledVector(_segDir, height / 2);
        _segP0.addScaledVector(_segDir, -height / 2);
        // Project both to screen.
        const proj0 = _segP0.clone().project(cam);
        const proj1 = _segP1.clone().project(cam);
        if (proj0.z > 1 || proj1.z > 1) continue;
        const sx0 = (proj0.x + 1) * hw;
        const sy0 = (-proj0.y + 1) * hh;
        const sx1 = (proj1.x + 1) * hw;
        const sy1 = (-proj1.y + 1) * hh;
        // Point-to-segment distance in 2D.
        const vx = sx1 - sx0;
        const vy = sy1 - sy0;
        const wx = mx - sx0;
        const wy = my - sy0;
        const segLen2 = vx * vx + vy * vy;
        let t = segLen2 > 0 ? (vx * wx + vy * wy) / segLen2 : 0;
        if (t < 0) t = 0;
        else if (t > 1) t = 1;
        const cx = sx0 + t * vx;
        const cy = sy0 + t * vy;
        const dist = Math.sqrt((mx - cx) ** 2 + (my - cy) ** 2);
        if (dist < bestDist) {
          bestDist = dist;
          bestId = Number(seg.getAttribute("data-arc-id"));
        }
      }
      return bestId;
    };

    // 2D highlight ring — a CSS circle overlay that tracks the node's screen position
    // Three.js ring highlight — rendered in WebGL so it works in all modes
    let hlRing = null;
    let hlGlow = null;
    let hlRingMat = null;
    let hlGlowMat = null;
    let vaporLevel = 0.3; // synced with slider default

    const ensureHlRing = () => {
      if (hlRing) return;
      if (typeof THREE === "undefined") return;
      // Thin torus for the ring outline
      const ringGeo = new THREE.TorusGeometry(1, 0.12, 8, 48);
      hlRingMat = new THREE.MeshBasicMaterial({
        color: 0xfbbf24,
        transparent: true,
        opacity: 0.8,
        depthTest: false,
        depthWrite: false,
      });
      hlRing = new THREE.Mesh(ringGeo, hlRingMat);
      hlRing.renderOrder = 998;
      hlRing.visible = false;

      // Glow disc behind the ring
      const glowGeo = new THREE.RingGeometry(0.5, 1.5, 32);
      hlGlowMat = new THREE.MeshBasicMaterial({
        color: 0xfbbf24,
        transparent: true,
        opacity: 0.12,
        depthTest: false,
        depthWrite: false,
        side: THREE.DoubleSide,
      });
      hlGlow = new THREE.Mesh(glowGeo, hlGlowMat);
      hlGlow.renderOrder = 997;
      hlGlow.visible = false;

      sceneEl.object3D.add(hlRing);
      sceneEl.object3D.add(hlGlow);
    };

    // --- Particle dust ---
    let particles = null;
    let particleMat = null;

    const ensureParticles = () => {
      if (particles) return;
      if (typeof THREE === "undefined") return;
      const count = 600;
      const positions = new Float32Array(count * 3);
      const domeR = clientData.clusterRadius;
      for (let i = 0; i < count; i++) {
        // Random positions within the dome sphere
        const r = domeR * Math.cbrt(Math.random());
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        positions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
        positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
        positions[i * 3 + 2] = r * Math.cos(phi);
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
      particleMat = new THREE.PointsMaterial({
        color: 0xffc0dd,
        size: 0.08,
        transparent: true,
        opacity: 0.0,
        depthTest: false,
        sizeAttenuation: true,
      });
      particles = new THREE.Points(geo, particleMat);
      particles.renderOrder = 500;
      turntable.object3D.add(particles);
    };

    const _hlWorld = new THREE.Vector3();
    const _hlCamPos = new THREE.Vector3();
    let prevClusterWireframe = null;

    const highlightNode = (node) => {
      ensureHlRing();
      if (!hlRing) { prevHighlightSphere = node; return; }

      // Hide previous cluster glow (unless wireframes toggle is on)
      if (prevClusterWireframe && !wireframesVisible) {
        prevClusterWireframe.setAttribute("visible", "false");
        prevClusterWireframe.object3D?.traverse((c) => {
          if (c.material && c.userData._vaporGlow) {
            c.material.color.set(c.userData._origWireColor);
            c.material.opacity = c.userData._origWireOpacity;
          }
        });
      }
      prevClusterWireframe = null;

      if (node) {
        const obj = node.object3D;
        const cam = sceneEl.camera;
        if (!obj || !cam) { hlRing.visible = false; hlGlow.visible = false; return; }

        obj.getWorldPosition(_hlWorld);
        cam.getWorldPosition(_hlCamPos);

        // Get sphere radius
        let r3d = 0.35;
        const sphere = node.querySelector(".clickable");
        if (sphere) {
          const geo = sphere.getAttribute("geometry");
          if (geo && typeof geo === "object" && geo.radius) r3d = geo.radius;
        }

        // Position at node, face camera
        hlRing.position.copy(_hlWorld);
        hlGlow.position.copy(_hlWorld);
        hlRing.lookAt(_hlCamPos);
        hlGlow.lookAt(_hlCamPos);

        const ringScale = r3d + 0.04;
        hlRing.scale.setScalar(ringScale);
        hlGlow.scale.setScalar(ringScale);
        hlGlow.userData._baseScale = ringScale;

        hlRing.visible = true;
        hlGlow.visible = true;

        // At high vapor, glow the parent cluster's wireframe sphere
        if (vaporLevel > 0.2) {
          const cluster = node.closest(".story-cluster");
          if (cluster) {
            // Find or create the glow orb for this cluster
            let orb = cluster.querySelector(".cluster-glow-orb");
            if (!orb) {
              orb = document.createElement("a-entity");
              orb.className = "cluster-glow-orb";
              const wf = cluster.querySelector(".cluster-wireframe");
              if (wf) {
                const wfPos = wf.getAttribute("position");
                orb.setAttribute("position", wfPos.x + " " + wfPos.y + " " + wfPos.z);
                const wfGeo = wf.getAttribute("geometry");
                const r = (wfGeo && typeof wfGeo === "object" && wfGeo.radius) ? wfGeo.radius : 5;
                orb.setAttribute("geometry", "primitive: sphere; radius: " + r + "; segmentsWidth: 24; segmentsHeight: 16");
              } else {
                orb.setAttribute("geometry", "primitive: sphere; radius: 5; segmentsWidth: 24; segmentsHeight: 16");
              }
              orb.setAttribute("material", "shader: flat; color: #fbbf24; opacity: 0; transparent: true; side: double; depthWrite: false");
              cluster.appendChild(orb);
            }
            orb.setAttribute("visible", "true");
            orb.object3D?.traverse((c) => {
              c.renderOrder = -1;
              if (c.material) {
                c.material.color.set(0xfbbf24);
                c.material.opacity = vaporLevel * 0.06;
                c.material.wireframe = false;
                c.material.depthWrite = false;
                c.material.needsUpdate = true;
              }
            });
            prevClusterWireframe = orb;
          }
        }
      } else {
        hlRing.visible = false;
        hlGlow.visible = false;
      }
      prevHighlightSphere = node;
    };

    const escAttr = (value) =>
      String(value)
        .replace(/&/g, "&amp;")
        .replace(/"/g, "&quot;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");

    // --- In-planetarium "Propose link" flow ---
    // States: null (idle) | { phase: "pickTarget" | "fillForm" | "submitting"
    //   | "success" | "error" | "needsAuth", from..., to..., message? }
    let linkingState = null;

    const nodeMeta = (node) => {
      const sceneId = node.getAttribute("data-scene-id") || "";
      const isHub = sceneId.endsWith("-hub");
      const storyId = node.getAttribute("data-story-id") || "";
      const dbSceneId = node.getAttribute("data-db-scene-id") || "";
      const sceneTitle = node.getAttribute("data-scene-title") || "";
      const storyTitle = node.getAttribute("data-story-title") || "";
      return { sceneId, isHub, storyId, dbSceneId, sceneTitle, storyTitle };
    };

    const proposalFormHref = (state) => {
      const params = new URLSearchParams();
      params.set("returnTo", "/story/" + state.from.storyId);
      if (state.from.dbSceneId) {
        params.set("contextSceneId", state.from.dbSceneId);
      }
      if (state.to?.storyId) {
        params.set("toStoryId", state.to.storyId);
      }
      if (state.to?.dbSceneId) {
        params.set("toSceneId", state.to.dbSceneId);
      }

      const query = params.toString();
      return "/author/story/" + encodeURIComponent(state.from.storyId) + "/links"
        + (query ? "?" + query : "")
        + "#propose";
    };

    const loginHrefForReturnTo = (returnTo) =>
      "/login?returnTo=" + encodeURIComponent(returnTo);

    const renderLinkingPanel = () => {
      if (!linkingState) return;
      const { from, to, phase, message } = linkingState;
      const fromLabel = from.isHub
        ? from.storyTitle
        : from.sceneTitle + ' · ' + from.storyTitle;
      const toLabel = to
        ? (to.isHub ? to.storyTitle : to.sceneTitle + ' · ' + to.storyTitle)
        : "";

      let html = '<div class="vsatlatarium__linking">';
      html += '<p class="vsatlatarium__linking-title">Proposing a link</p>';
      html += '<p class="vsatlatarium__linking-pair">';
      html += '<span class="vsatlatarium__linking-from">' + escAttr(fromLabel) + '</span>';
      html += '<span class="vsatlatarium__linking-arrow">&rarr;</span>';
      html += to
        ? '<span class="vsatlatarium__linking-to">' + escAttr(toLabel) + '</span>'
        : '<span class="vsatlatarium__linking-to vsatlatarium__linking-to--placeholder">pick a target node</span>';
      html += '</p>';

      if (phase === "pickTarget") {
        html += '<p class="vsatlatarium__linking-hint">Click another node to set the target. Press Esc or Cancel to back out.</p>';
        html += '<button type="button" class="vsatlatarium__linking-btn vsatlatarium__linking-btn--ghost" data-linking-cancel>Cancel</button>';
      } else if (phase === "fillForm" || phase === "submitting") {
        html += '<form class="vsatlatarium__linking-form" data-linking-form>';
        html += '<label class="vsatlatarium__linking-label">Link type'
          + '<select name="linkType">'
          + '<option value="adjacency">Adjacency</option>'
          + '<option value="thematic" selected>Thematic</option>'
          + '<option value="causal">Causal</option>'
          + '<option value="contrast">Contrast</option>'
          + '</select></label>';
        html += '<label class="vsatlatarium__linking-label">Rationale'
          + '<textarea name="rationale" rows="3" required '
          + 'placeholder="Why are these stories connected?"></textarea></label>';
        const submitting = phase === "submitting";
        html += '<div class="vsatlatarium__linking-actions">';
        html += '<button type="submit" class="vsatlatarium__linking-btn"' + (submitting ? ' disabled' : '') + '>'
          + (submitting ? 'Submitting…' : 'Propose') + '</button>';
        html += '<button type="button" class="vsatlatarium__linking-btn vsatlatarium__linking-btn--ghost" data-linking-cancel>Cancel</button>';
        html += '</div>';
        html += '</form>';
      } else if (phase === "success") {
        html += '<p class="vsatlatarium__linking-msg vsatlatarium__linking-msg--ok">Proposed — arc added to the planetarium.</p>';
        const linksHref = "/author/story/" + encodeURIComponent(linkingState.from.storyId) + "/links";
        html += '<div class="vsatlatarium__linking-actions">';
        html += '<a class="vsatlatarium__linking-btn vsatlatarium__linking-btn--ghost" href="' + linksHref + '" target="_blank" rel="noopener">View on links page</a>';
        html += '<button type="button" class="vsatlatarium__linking-btn" data-linking-cancel>Close</button>';
        html += '</div>';
      } else if (phase === "needsAuth") {
        html += '<p class="vsatlatarium__linking-msg vsatlatarium__linking-msg--warn">Log in to propose a link.</p>';
        const linksHref = proposalFormHref(linkingState);
        html += '<div class="vsatlatarium__linking-actions">';
        html += '<a class="vsatlatarium__linking-btn" href="' + escAttr(loginHrefForReturnTo(linksHref)) + '">Log in to continue</a>';
        html += '<a class="vsatlatarium__linking-btn vsatlatarium__linking-btn--ghost" href="' + escAttr(linksHref) + '" target="_blank" rel="noopener">Open form &#x2197;</a>';
        html += '<button type="button" class="vsatlatarium__linking-btn vsatlatarium__linking-btn--ghost" data-linking-cancel>Close</button>';
        html += '</div>';
      } else if (phase === "error") {
        html += '<p class="vsatlatarium__linking-msg vsatlatarium__linking-msg--err">' + escAttr(message || 'Something went wrong.') + '</p>';
        html += '<div class="vsatlatarium__linking-actions">';
        html += '<button type="button" class="vsatlatarium__linking-btn" data-linking-retry>Try again</button>';
        html += '<button type="button" class="vsatlatarium__linking-btn vsatlatarium__linking-btn--ghost" data-linking-cancel>Cancel</button>';
        html += '</div>';
      }

      html += '</div>';
      infoEl.innerHTML = html;
    };

    const enterLinkingMode = (fromNode) => {
      const from = nodeMeta(fromNode);
      if (!from.storyId) return;
      linkingState = { from, to: null, phase: "pickTarget" };
      canvas.style.cursor = "crosshair";
      renderLinkingPanel();
    };

    const exitLinkingMode = () => {
      const wasLinking = !!linkingState;
      linkingState = null;
      if (wasLinking) {
        canvas.style.cursor = "";
        if (hoveredNode) showInfo(hoveredNode);
        else infoEl.innerHTML = "";
      }
    };

    // Append a new arc to the live planetarium. Called after a
    // successful POST so the user can see their proposal land
    // immediately instead of having to reload.
    const addArcLive = (link) => {
      if (!isPlanetarium) return;
      const fromCluster = clientData.clusters.find(
        (c) => c.storyId === link.fromStory.id,
      );
      const toCluster = clientData.clusters.find(
        (c) => c.storyId === link.toStory.id,
      );
      if (!fromCluster || !toCluster) return;

      let fromPos = fromCluster.storyNodePos;
      if (link.fromScene) {
        const sourceScene = fromCluster.scenes.find((s) => s.sceneId === link.fromScene.id);
        if (sourceScene) fromPos = sourceScene.position;
      }
      let toPos = toCluster.storyNodePos;
      if (link.toScene) {
        const targetScene = toCluster.scenes.find((s) => s.sceneId === link.toScene.id);
        if (targetScene) toPos = targetScene.position;
      }

      const arc = {
        id: link.id,
        status: link.status,
        linkType: link.linkType,
        rationale: link.rationale ?? "",
        fromPos,
        toPos,
        fromStoryTitle: link.fromStory.title,
        toStoryTitle: link.toStory.title,
      };
      clientData.interArcs.push(arc);
      arcMetaById.set(arc.id, arc);

      const { color, opacity, bowFactor } = arcVisualForLink(arc);
      const cp = arcControlPoint(fromPos, toPos, bowFactor);
      arcDefs.push({
        from: fromPos,
        to: toPos,
        controlPoint: cp,
        color,
        opacity,
        radius: 0.05,
        arcType: arc.linkType,
        arcId: arc.id,
      });
      refreshArcs();

      // Update the per-story arc index used by the hover panel.
      for (const title of [arc.fromStoryTitle, arc.toStoryTitle]) {
        if (!arcsByStory.has(title)) arcsByStory.set(title, []);
        arcsByStory.get(title).push(arc);
      }
    };

    const submitProposal = async () => {
      if (!linkingState || !linkingState.to) return;
      const form = infoEl.querySelector("[data-linking-form]");
      if (!form) return;
      const data = new FormData(form);
      const rationale = String(data.get("rationale") || "").trim();
      const linkType = String(data.get("linkType") || "thematic");
      if (!rationale) return;

      linkingState.phase = "submitting";
      renderLinkingPanel();

      const body = {
        toStoryId: Number(linkingState.to.storyId),
        linkType,
        rationale,
      };
      if (linkingState.to.dbSceneId) {
        body.toSceneId = Number(linkingState.to.dbSceneId);
      }
      if (!linkingState.from.isHub && linkingState.from.dbSceneId) {
        body.fromSceneId = Number(linkingState.from.dbSceneId);
      }

      try {
        const res = await fetch(
          "/api/story/" + encodeURIComponent(linkingState.from.storyId) + "/links",
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
            credentials: "same-origin",
          },
        );
        if (res.ok) {
          try {
            const link = await res.json();
            addArcLive(link);
          } catch {}
          linkingState.phase = "success";
        } else if (res.status === 401 || res.status === 403) {
          linkingState.phase = "needsAuth";
        } else {
          linkingState.phase = "error";
          linkingState.message = "Server returned " + res.status + ".";
        }
      } catch (err) {
        linkingState.phase = "error";
        linkingState.message = "Network error: " + (err?.message || err);
      }
      renderLinkingPanel();
    };

    // Delegated handlers for the panel buttons / form (panel HTML is
    // rebuilt on each transition, so direct listeners would be lost).
    infoEl.addEventListener("click", (e) => {
      const target = e.target instanceof Element ? e.target : null;
      if (!target) return;
      if (target.closest("[data-linking-cancel]")) {
        exitLinkingMode();
        return;
      }
      if (target.closest("[data-linking-retry]")) {
        if (linkingState) {
          linkingState.phase = "fillForm";
          linkingState.message = undefined;
          renderLinkingPanel();
        }
        return;
      }
      const proposeBtn = target.closest("[data-propose-from]");
      if (proposeBtn) {
        e.preventDefault();
        const fromStoryId = proposeBtn.getAttribute("data-from-story-id") || "";
        const fromSceneId = proposeBtn.getAttribute("data-from-db-scene-id") || "";
        const fromIsHub = proposeBtn.getAttribute("data-from-is-hub") === "1";
        const fromSceneTitle = proposeBtn.getAttribute("data-from-scene-title") || "";
        const fromStoryTitle = proposeBtn.getAttribute("data-from-story-title") || "";
        linkingState = {
          from: {
            storyId: fromStoryId,
            dbSceneId: fromSceneId,
            isHub: fromIsHub,
            sceneTitle: fromSceneTitle,
            storyTitle: fromStoryTitle,
          },
          to: null,
          phase: "pickTarget",
        };
        canvas.style.cursor = "crosshair";
        renderLinkingPanel();
      }
    });

    infoEl.addEventListener("submit", (e) => {
      const form = e.target instanceof Element ? e.target.closest("[data-linking-form]") : null;
      if (!form) return;
      e.preventDefault();
      submitProposal();
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && linkingState) exitLinkingMode();
    });

    const showInfo = (node) => {
      if (linkingState) return; // panel locked while linking
      const sceneTitle = node.getAttribute("data-scene-title");
      const storyTitle = node.getAttribute("data-story-title");
      const pageCount = node.getAttribute("data-page-count");
      const isOpening = node.getAttribute("data-is-opening");
      const sceneId = node.getAttribute("data-scene-id") || "";
      const storyId = node.getAttribute("data-story-id");
      const isHub = sceneId.endsWith("-hub");
      const dbSceneId = node.getAttribute("data-db-scene-id") || "";

      let html = '<p class="vsatlatarium__info-story">' + storyTitle + '</p>';
      if (isHub) {
        html += '<p class="vsatlatarium__info-scene">Story hub</p>';
      } else {
        html += '<p class="vsatlatarium__info-scene">' + sceneTitle + '</p>';
        html += '<p class="vsatlatarium__info-meta">';
        html += isOpening ? 'Opening scene' : 'Scene';
        if (pageCount && Number(pageCount) > 1) html += ' &middot; ' + pageCount + ' pages';
        html += '</p>';
      }

      const storyArcs = arcsByStory.get(storyTitle);
      if (storyArcs && storyArcs.length > 0) {
        const unique = new Set();
        html += '<div class="vsatlatarium__info-links">';
        for (const arc of storyArcs) {
          const other = arc.fromStoryTitle === storyTitle ? arc.toStoryTitle : arc.fromStoryTitle;
          const key = arc.linkType + '-' + other;
          if (unique.has(key)) continue;
          unique.add(key);
          html += '<p class="vsatlatarium__info-link">'
            + '<span class="vsatlatarium__info-link-type">' + arc.linkType + '</span> '
            + other + '</p>';
        }
        html += '</div>';
      }

      if (storyId) {
        const proposeHref = "/author/story/" + storyId + "/links"
          + (dbSceneId ? ("?contextSceneId=" + encodeURIComponent(dbSceneId)) : "")
          + "#propose";
        html += '<div class="vsatlatarium__info-actions">';
        html += '<button type="button" class="vsatlatarium__info-propose" '
          + 'data-propose-from '
          + 'data-from-story-id="' + escAttr(storyId) + '" '
          + 'data-from-db-scene-id="' + escAttr(dbSceneId) + '" '
          + 'data-from-is-hub="' + (isHub ? "1" : "0") + '" '
          + 'data-from-scene-title="' + escAttr(sceneTitle || "") + '" '
          + 'data-from-story-title="' + escAttr(storyTitle || "") + '">'
          + 'Propose link from this ' + (isHub ? 'story' : 'scene') + ' &rarr;</button>';
        html += '<a class="vsatlatarium__info-propose-alt" href="' + proposeHref
          + '" target="_blank" rel="noopener">open form &#x2197;</a>';
        html += '</div>';
      }

      infoEl.innerHTML = html;
    };

    // Render the info panel for an inter-story arc. Looks up the arc
    // by id and shows from → to titles, link type, status, rationale.
    let hoveredArcId = null;
    const showArcInfo = (arcId) => {
      if (linkingState) return; // panel locked while linking
      const arc = arcMetaById.get(arcId);
      if (!arc) return;
      let html = '<p class="vsatlatarium__info-story">Interpretive link</p>';
      html += '<p class="vsatlatarium__info-arc-pair">';
      html += '<span>' + escAttr(arc.fromStoryTitle) + '</span>';
      html += '<span class="vsatlatarium__info-arc-arrow">&rarr;</span>';
      html += '<span>' + escAttr(arc.toStoryTitle) + '</span>';
      html += '</p>';
      html += '<p class="vsatlatarium__info-meta vsatlatarium__info-arc-meta">';
      html += '<span class="vsatlatarium__info-link-type">' + escAttr(arc.linkType) + '</span>';
      html += ' &middot; <span class="vsatlatarium__info-arc-status vsatlatarium__info-arc-status--'
        + escAttr(arc.status) + '">' + escAttr(arc.status) + '</span>';
      html += '</p>';
      if (arc.rationale) {
        html += '<p class="vsatlatarium__info-arc-rationale">' + escAttr(arc.rationale) + '</p>';
      }
      infoEl.innerHTML = html;
    };

    // Hover + click: use window-level events (reliable across browsers)
    const initInteraction = () => {
      collectNodes();

      // Sticky info panel: clear the highlight ring and cursor when the
      // mouse leaves a node, but keep the last-shown info panel visible
      // so its propose-link button stays reachable in the sidebar.
      const linkingCursor = () =>
        linkingState && linkingState.phase === "pickTarget" ? "crosshair" : "";
      window.addEventListener("mousemove", (e) => {
        if (isDragging) return;
        if (!sceneEl.canvas) return;
        const rect = sceneEl.canvas.getBoundingClientRect();
        if (e.clientX < rect.left || e.clientX > rect.right ||
            e.clientY < rect.top || e.clientY > rect.bottom) {
          if (hoveredNode) {
            hoveredNode = null;
            highlightNode(null);
            canvas.style.cursor = linkingCursor();
          }
          return;
        }
        const hit = findNearest(e.clientX, e.clientY);
        if (hit !== hoveredNode) {
          hoveredNode = hit;
          highlightNode(hit);
          if (hit) {
            hoveredArcId = null;
            showInfo(hit);
            canvas.style.cursor = linkingState && linkingState.phase === "pickTarget"
              ? "crosshair"
              : "pointer";
            return;
          }
          // Node hover ended; fall through to arc check below.
        }
        // Always check arcs when no node is hovered. (Without this,
        // moving the cursor over the arcs after leaving a node never
        // re-runs detection.)
        if (!hit) {
          const arcId = findNearestArc(e.clientX, e.clientY);
          if (arcId !== hoveredArcId) {
            hoveredArcId = arcId;
            if (arcId !== null && !linkingState) {
              showArcInfo(arcId);
              canvas.style.cursor = "pointer";
            } else {
              canvas.style.cursor = linkingCursor();
            }
          }
        }
      });

      canvas.addEventListener("click", (e) => {
        if (dragTotal > 5) return;
        // "canvas" is the wrapper div: clicks on real controls layered
        // over it (toolbar, "?" panel, popovers) are not node picks
        if (e.target instanceof Element &&
            e.target.closest("button, a, input, textarea, [contenteditable], .vsatlatarium__usage")) return;
        const hit = findNearest(e.clientX, e.clientY);
        if (!hit) return;

        // Linking-mode pick: capture target and switch to form phase
        if (linkingState && linkingState.phase === "pickTarget") {
          const to = nodeMeta(hit);
          if (!to.storyId) return;
          // Disallow self-link (same scene). Allow same-story different-scene
          // and story↔story (hub↔hub) for now.
          const fromKey = linkingState.from.storyId + ":" + linkingState.from.dbSceneId;
          const toKey = to.storyId + ":" + to.dbSceneId;
          if (fromKey === toKey) return;
          linkingState.to = to;
          linkingState.phase = "fillForm";
          renderLinkingPanel();
          return;
        }

        const storyId = hit.getAttribute("data-story-id");
        if (storyId) {
          const dbSceneId = hit.getAttribute("data-db-scene-id") || "";
          const sceneQuery = dbSceneId
            ? "?scene=" + encodeURIComponent(dbSceneId)
            : "";
          window.location.href = "/story/" + storyId + sceneQuery;
        }
      });

      // --- Focus board (M-authoring-3d C1): right-click a story and
      // everything else falls away — its scenes become editable cards wired
      // by their narrative arcs. Cards are DOM (crisp text, contenteditable)
      // tracking the projected 3D node positions, so dragging the turntable
      // still moves the board. Click a card to edit its opening page; saves
      // go through the shared draft-insert → save → republish path.
      const focusState = { storyId: null, raf: 0, els: null };

      const focusCss = document.createElement("style");
      focusCss.textContent = [
        ".vsat-focus{position:absolute;inset:0;z-index:30;pointer-events:none;font-family:'Source Sans Pro',system-ui,sans-serif}",
        ".vsat-focus__scrim{position:absolute;inset:0;background:rgba(5,7,12,0.88)}",
        ".vsat-focus__wires{position:absolute;inset:0;width:100%;height:100%}",
        ".vsat-focus__head{position:absolute;top:0.6rem;left:0.75rem;right:0.75rem;display:flex;gap:0.75rem;align-items:center;color:#e2eaff;pointer-events:auto}",
        ".vsat-focus__head strong{font-size:1.05rem}",
        ".vsat-focus__head span{opacity:0.6;font-size:0.8rem;flex:1}",
        ".vsat-focus__head button{font:inherit;font-size:0.8rem;padding:0.25rem 0.7rem;border-radius:999px;border:1px solid #3c5976;background:#1b2129;color:#ecf0f1;cursor:pointer}",
        ".vsat-focus__card{position:absolute;transform:translate(-50%,-50%);width:200px;padding:0.5rem 0.6rem;border-radius:0.6rem;background:rgba(18,21,27,0.95);border:1px solid rgba(150,170,190,0.35);color:#ecf0f1;pointer-events:auto;cursor:pointer;box-shadow:0 8px 30px rgba(0,0,0,0.5)}",
        ".vsat-focus__card:hover{border-color:rgba(241,196,15,0.7)}",
        ".vsat-focus__card--editing{width:320px;cursor:default;z-index:5;border-color:rgba(241,196,15,0.9)}",
        ".vsat-focus__card-title{font-size:0.7rem;letter-spacing:0.06em;text-transform:uppercase;color:#9fb3c8;margin-bottom:0.25rem}",
        ".vsat-focus__card-heading{font-weight:600;font-size:0.95rem;margin-bottom:0.2rem}",
        ".vsat-focus__card-body{font-size:0.78rem;line-height:1.35;color:#c9d4de;white-space:pre-wrap;max-height:7.5em;overflow:hidden}",
        ".vsat-focus__card--editing .vsat-focus__card-body{max-height:14em;overflow-y:auto}",
        ".vsat-focus__card--editing [contenteditable]{outline:1px dashed rgba(150,170,190,0.5);outline-offset:2px;border-radius:0.25rem;cursor:text}",
        ".vsat-focus__card-foot{font-size:0.66rem;color:#7d8b99;margin-top:0.3rem}",
        ".vsat-focus__card-actions{display:flex;gap:0.4rem;justify-content:flex-end;margin-top:0.45rem}",
        ".vsat-focus__card-actions button{font:inherit;font-size:0.75rem;padding:0.2rem 0.65rem;border-radius:0.45rem;border:1px solid #3c5976;background:#2c3e50;color:#ecf0f1;cursor:pointer}",
        ".vsat-focus__card-actions button[data-save]{background:#3c5976}",
        ".vsat-focus__card-err{font-size:0.72rem;color:#e74c3c;margin-top:0.3rem}",
        ".vsat-focus__card-verbs{display:flex;gap:0.35rem;margin-top:0.35rem}",
        ".vsat-focus__card-verbs button{font:inherit;font-size:0.68rem;padding:0.1rem 0.5rem;border-radius:0.4rem;border:1px solid rgba(150,170,190,0.35);background:transparent;color:#9fb3c8;cursor:pointer}",
        ".vsat-focus__card-verbs button:hover{border-color:rgba(241,196,15,0.7);color:#ecf0f1}",
        ".vsat-focus__connect-form{margin-top:0.4rem;display:flex;flex-direction:column;gap:0.35rem}",
        ".vsat-focus__connect-form input{font:inherit;font-size:0.78rem;padding:0.25rem 0.4rem;border-radius:0.35rem;border:1px solid #3c5976;background:#0d1117;color:#ecf0f1}",
        // hint + link chip live INSIDE the canvas wrapper, below its
        // toolbar — viewport-fixed placement covered the toolbar (QA,
        // 2026-08-16)
        ".vsat-focus3d-hint{position:absolute;top:3.1rem;left:50%;transform:translateX(-50%);z-index:15;background:rgba(18,21,27,0.95);border:1px solid rgba(232,163,61,0.8);color:#ecf0f1;font-size:0.85rem;padding:0.4rem 0.9rem;border-radius:999px;font-family:'Source Sans Pro',system-ui,sans-serif;max-width:80%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}",
        // bottom:4rem clears both the Astro dev toolbar (dev mode,
        // bottom-centre, intercepts clicks) and the Cardboard hint text
        ".vsat-focus3d-create{position:fixed;bottom:4rem;left:50%;transform:translateX(-50%);z-index:10003;font-family:'Source Sans Pro',system-ui,sans-serif;font-size:0.85rem;padding:0.4rem 1rem;border-radius:999px;border:1px solid #3c5976;background:rgba(18,21,27,0.95);color:#ecf0f1;cursor:pointer}",
        ".vsat-focus3d-create:hover{border-color:rgba(232,163,61,0.8)}",
        ".vsat-focus3d-linkchip{position:absolute;z-index:15;display:flex;gap:0.6rem;align-items:center;background:rgba(18,21,27,0.95);border:1px solid rgba(232,163,61,0.8);color:#ecf0f1;font-size:0.85rem;padding:0.35rem 0.7rem;border-radius:999px;font-family:'Source Sans Pro',system-ui,sans-serif;max-width:60%;}",
        ".vsat-focus3d-linkchip span:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}",
        ".vsat-focus3d-linkchip button{font:inherit;font-size:0.75rem;padding:0.15rem 0.6rem;border-radius:0.45rem;border:1px solid #7a3c3c;background:#3a2020;color:#f0c9c9;cursor:pointer;flex:none}",
        ".vsat-focus3d-linkchip-err{color:#e74c3c;font-size:0.75rem}",
        ".vsat-voice-chip{position:absolute;bottom:0.9rem;left:50%;transform:translateX(-50%);z-index:16;max-width:80%;background:rgba(18,21,27,0.95);border:1px solid rgba(120,140,180,0.6);color:#ecf0f1;font-size:0.85rem;padding:0.4rem 0.9rem;border-radius:999px;font-family:'Source Sans Pro',system-ui,sans-serif;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}",
        ".vsat-voice-chip[data-state='rec']{border-color:#e74c3c;color:#f5b7b1}",
        ".vsat-voice-chip[data-state='busy']{border-color:#e8a33d}",
        ".vsat-voice-chip[data-state='ok']{border-color:#3fa08f}",
        ".vsat-voice-chip[data-state='err']{border-color:#e74c3c}",
      ].join("");
      document.head.appendChild(focusCss);

      const exitFocus = () => {
        if (!focusState.els) return;
        cancelAnimationFrame(focusState.raf);
        focusState.els.root.remove();
        focusState.els = null;
        focusState.storyId = null;
      };

      // read a page's heading + body out of raw draft content (pages are
      // delimited by # heading lines; links/hotspots/@panel are preserved
      // separately by the save path)
      const readPageSection = (content, pageNumber) => {
        const lines = content.split("\n");
        const headings = [];
        lines.forEach((l, i) => { if (/^\s*#/.test(l)) headings.push(i); });
        const start = headings[pageNumber];
        if (start === undefined) return null;
        const end = pageNumber + 1 < headings.length ? headings[pageNumber + 1] : lines.length;
        const headingLine = lines[start] || "#";
        const heading = headingLine.replace(/^\s*#\s*/, "").replace(/\s*\|.*$/, "").trim();
        const body = lines
          .slice(start + 1, end)
          .filter((l) => !/^\s*(\[|@panel\b)/i.test(l))
          .join("\n")
          .replace(/\n{3,}/g, "\n\n")
          .trim();
        return { heading, body };
      };

      const openCardEditor = async (sceneNode, card) => {
        if (card.classList.contains("vsat-focus__card--editing")) return;
        card.classList.add("vsat-focus__card--editing");
        const headingEl = card.querySelector("[data-h]");
        const bodyEl = card.querySelector("[data-b]");
        const err = document.createElement("p");
        err.className = "vsat-focus__card-err";
        err.hidden = true;
        const actions = document.createElement("div");
        actions.className = "vsat-focus__card-actions";
        actions.innerHTML = '<button type="button" data-cancel>Cancel</button><button type="button" data-save>Save</button>';
        card.appendChild(err);
        card.appendChild(actions);

        // the card shows a trimmed excerpt — load the FULL draft page before
        // letting anyone edit, or saving would truncate their scene
        let section = null;
        try {
          const res = await fetch("/api/story/" + sceneNode.storyId + "/scene/" + sceneNode.sceneId);
          if (!res.ok) throw new Error("couldn't load the draft (" + res.status + ")");
          const draft = await res.json();
          section = readPageSection(draft.content || "", 0);
        } catch (e) {
          err.textContent = String((e && e.message) || e);
          err.hidden = false;
        }
        if (section) {
          headingEl.textContent = section.heading;
          bodyEl.textContent = section.body;
          for (const el of [headingEl, bodyEl]) {
            try { el.contentEditable = "plaintext-only"; } catch (_) { el.contentEditable = "true"; }
          }
          bodyEl.focus();
        }

        const closeEditor = () => {
          card.classList.remove("vsat-focus__card--editing");
          headingEl.contentEditable = "false";
          bodyEl.contentEditable = "false";
          err.remove();
          actions.remove();
        };
        actions.querySelector("[data-cancel]").addEventListener("click", (e) => {
          e.stopPropagation();
          closeEditor();
          headingEl.textContent = sceneNode.heading;
          bodyEl.textContent = sceneNode.excerpt;
        });
        actions.querySelector("[data-save]").addEventListener("click", async (e) => {
          e.stopPropagation();
          if (!section) return;
          const heading = (headingEl.textContent || "").trim();
          const body = (bodyEl.innerText || "").trim();
          if (!heading) return;
          const edit = window.__vsatEdit;
          if (!edit) { err.textContent = "edit bridge unavailable"; err.hidden = false; return; }
          e.target.disabled = true;
          err.hidden = true;
          try {
            await edit.mutateDraftContent(sceneNode.storyId, sceneNode.sceneId, (content) =>
              edit.replaceSectionText(content, 0, heading, body));
            sceneNode.heading = heading;
            sceneNode.excerpt = body.length > 200 ? body.slice(0, 200).trimEnd() + "…" : body;
            closeEditor();
            headingEl.textContent = sceneNode.heading;
            bodyEl.textContent = sceneNode.excerpt;
          } catch (e2) {
            err.textContent = String((e2 && e2.message) || e2);
            err.hidden = false;
            e.target.disabled = false;
          }
        });
      };

      const enterFocus = (storyId) => {
        exitFocus();
        if (!isPlanetarium) {
          enterFocus3D(storyId);
          return;
        }
        const cluster = clientData.clusters.find((c) => String(c.storyId) === String(storyId));
        if (!cluster) return;
        focusState.storyId = storyId;

        const host = canvas.parentElement;
        if (getComputedStyle(host).position === "static") host.style.position = "relative";
        const root = document.createElement("div");
        root.className = "vsat-focus";
        const scrim = document.createElement("div");
        scrim.className = "vsat-focus__scrim";
        root.appendChild(scrim);
        const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        svg.setAttribute("class", "vsat-focus__wires");
        root.appendChild(svg);
        const head = document.createElement("div");
        head.className = "vsat-focus__head";
        const title = document.createElement("strong");
        title.textContent = cluster.title;
        const hint = document.createElement("span");
        hint.textContent = "story structure — click a card to edit · drag to rotate · Esc to close";
        const closeBtn = document.createElement("button");
        closeBtn.type = "button";
        closeBtn.textContent = "✕ Close";
        closeBtn.addEventListener("click", exitFocus);
        head.append(title, hint, closeBtn);
        root.appendChild(head);

        const cards = new Map();
        for (const sn of cluster.scenes) {
          const card = document.createElement("div");
          card.className = "vsat-focus__card";
          card.dataset.sceneId = String(sn.sceneId);
          const t = document.createElement("div");
          t.className = "vsat-focus__card-title";
          t.textContent = sn.title + (sn.isOpening ? " · start" : "");
          const h = document.createElement("div");
          h.className = "vsat-focus__card-heading";
          h.setAttribute("data-h", "");
          h.textContent = sn.heading || "";
          const b = document.createElement("div");
          b.className = "vsat-focus__card-body";
          b.setAttribute("data-b", "");
          b.textContent = sn.excerpt || "";
          const f = document.createElement("div");
          f.className = "vsat-focus__card-foot";
          f.textContent = sn.pageCount > 1 ? "editing page 1 of " + sn.pageCount : "";
          card.append(t, h, b, f);
          card.addEventListener("click", (e) => {
            e.stopPropagation();
            openCardEditor(sn, card);
          });
          root.appendChild(card);
          cards.set(sn.id, card);
        }
        focusState.els = { root, svg, cards, cluster };
        host.appendChild(root);

        // rotate the turntable to face this cluster (reuse the story-list
        // facing behaviour) so the board opens roughly centred
        for (const btn of document.querySelectorAll(".vsatlatarium__story")) {
          if (btn.getAttribute("data-story-id") === String(cluster.storyId)) {
            btn.click();
            break;
          }
        }

        const project = () => {
          if (!focusState.els) return;
          const rect = canvas.getBoundingClientRect();
          const rootRect = root.getBoundingClientRect();
          const cam = sceneEl.camera;
          const pts = new Map();
          for (const [id, card] of cards) {
            const entity = document.querySelector('.scene-node[data-scene-id="' + id + '"]');
            if (!entity || !entity.object3D || !cam) continue;
            entity.object3D.getWorldPosition(_worldPos);
            _projected.copy(_worldPos).project(cam);
            const behind = _projected.z > 1;
            const x = rect.left - rootRect.left + ((_projected.x + 1) / 2) * rect.width;
            const y = rect.top - rootRect.top + ((1 - _projected.y) / 2) * rect.height;
            pts.set(id, { x, y, behind, card });
          }
          // a dome cluster is angularly compact — spread the board out
          // around its screen centroid so cards don't pile up
          const visible = [...pts.values()].filter((p) => !p.behind);
          if (visible.length) {
            const cx = visible.reduce((a, p) => a + p.x, 0) / visible.length;
            const cy = visible.reduce((a, p) => a + p.y, 0) / visible.length;
            const SPREAD = 2.4;
            for (const p of pts.values()) {
              p.x = cx + (p.x - cx) * SPREAD;
              p.y = cy + (p.y - cy) * SPREAD;
              p.x = Math.max(120, Math.min(rootRect.width - 120, p.x));
              p.y = Math.max(90, Math.min(rootRect.height - 70, p.y));
              p.card.style.left = p.x + "px";
              p.card.style.top = p.y + "px";
              p.card.style.display = p.behind ? "none" : "";
            }
          }
          while (svg.firstChild) svg.firstChild.remove();
          svg.setAttribute("viewBox", "0 0 " + rootRect.width + " " + rootRect.height);
          for (const arc of cluster.internalArcs) {
            const a = pts.get(arc.from);
            const b = pts.get(arc.to);
            if (!a || !b || a.behind || b.behind) continue;
            const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
            line.setAttribute("x1", a.x); line.setAttribute("y1", a.y);
            line.setAttribute("x2", b.x); line.setAttribute("y2", b.y);
            line.setAttribute("stroke", "#e8a33d");
            line.setAttribute("stroke-width", "1.6");
            line.setAttribute("stroke-opacity", "0.75");
            svg.appendChild(line);
          }
          focusState.raf = requestAnimationFrame(project);
        };
        project();
      };

      // --- Focus, GeomView flavour (slice 2 direction): the cards live IN
      // the 3D space — billboarded card entities at the scene positions,
      // everything else hidden in-scene. Click a card to edit via a
      // centred popover; saves sync back onto the 3D card. This is the
      // VR-capable path (no DOM board).
      const focus3D = { storyId: null, entities: [], hidden: [], cards: new Map(), connect: null, createPill: null, createForm: null, removeForm: null };

      const exitFocus3D = () => {
        if (!focus3D.storyId) return;
        cancelConnect3D();
        clearCurrentArc();
        arcCurrent.samples.clear();
        voice.dictating = null;
        if (voice.chip) clearVoiceChip();
        focus3D.createPill?.remove();
        focus3D.createPill = null;
        focus3D.createForm?.remove();
        focus3D.createForm = null;
        focus3D.removeForm?.remove();
        focus3D.removeForm = null;
        sceneLabelsPinnedHidden = false;
        cancelAnimationFrame(focus3D.raf);
        if (focus3D.holdPivot) {
          window.removeEventListener("mousemove", focus3D.holdPivot);
          canvas.removeEventListener("wheel", focus3D.holdPivot);
          focus3D.holdPivot = null;
        }
        if (turntable?.object3D) turntable.object3D.position.set(0, 0, 0);
        for (const el of focus3D.entities) el.remove();
        for (const el of focus3D.hidden) el.setAttribute("visible", "true");
        focus3D.entities = [];
        focus3D.hidden = [];
        focus3D.cards.clear();
        focus3D.storyId = null;
        if (focus3D.prevCamZ !== undefined) {
          camZ = focus3D.prevCamZ;
          focus3D.prevCamZ = undefined;
          applyTransform();
        }
      };

      const cardTroikaValue = (value, fontSize, color) =>
        "value: " + String(value || "").replace(/;/g, ",") + "; fontSize: " + fontSize +
        "; color: " + color + "; anchor: left; baseline: top; maxWidth: 2.5";
      const cardText = (value, fontSize, color, y) => {
        const el = document.createElement("a-troika-text");
        el.setAttribute("troika-text", cardTroikaValue(value, fontSize, color));
        el.setAttribute("position", "-1.28 " + y + " 0.012");
        return el;
      };

      const enterFocus3D = (storyId) => {
        exitFocus3D();
        const cluster = clientData.clusters.find((c) => String(c.storyId) === String(storyId));
        if (!cluster) return;
        focus3D.storyId = String(storyId);

        // hide the rest of the constellation in-scene: other clusters and
        // every arc segment that isn't this story's (inter-story arcs carry
        // no data-story-id, so they hide too)
        document.querySelectorAll(".story-cluster").forEach((el) => {
          if (el.getAttribute("data-story-id") !== String(storyId)) {
            el.setAttribute("visible", "false");
            focus3D.hidden.push(el);
          }
        });
        turntable.querySelectorAll(".arc-segment").forEach((el) => {
          if (el.getAttribute("data-story-id") !== String(storyId)) {
            el.setAttribute("visible", "false");
            focus3D.hidden.push(el);
          }
        });
        // the cards carry the text now — rest the cluster's floating labels
        const clusterEl = document.querySelector('.story-cluster[data-story-id="' + storyId + '"]');
        if (clusterEl) {
          clusterEl.querySelectorAll("[troika-text]").forEach((el) => {
            el.setAttribute("visible", "false");
            focus3D.hidden.push(el);
          });
        }
        // keep scene labels down through the dolly-in (see the flag decl):
        // the upcoming applyTransform would otherwise re-reveal them.
        sceneLabelsPinnedHidden = true;

        for (const btn of document.querySelectorAll(".vsatlatarium__story")) {
          if (btn.getAttribute("data-story-id") === String(cluster.storyId)) {
            btn.click();
            break;
          }
        }

        // dolly in: the cluster sits ~|center| out along the faced axis;
        // bring the camera to comfortable card-reading distance
        const centerLen = Math.hypot(cluster.center.x, cluster.center.y, cluster.center.z);
        focus3D.prevCamZ = camZ;
        camZ = clamp(centerLen + cluster.localRadius * 2.6, camZMin, camZMax);
        applyTransform();

        // while focused, dragging should rotate the card model about ITS OWN
        // centre — not swing it around the distant world origin. The
        // correction must run SYNCHRONOUSLY in the same events that rotate
        // the world: a rAF-only correction lags a frame behind the mouse
        // and the model jitters during drags.
        const pivotLocal = new THREE.Vector3(cluster.center.x, cluster.center.y, cluster.center.z);
        const pivotWorld = pivotLocal.clone().applyQuaternion(turntable.object3D.quaternion);
        const pivotTmp = new THREE.Vector3();
        const holdPivot = () => {
          if (!focus3D.storyId) return;
          pivotTmp.copy(pivotLocal).applyQuaternion(turntable.object3D.quaternion);
          turntable.object3D.position.copy(pivotWorld).sub(pivotTmp);
        };
        focus3D.holdPivot = holdPivot;
        // registered after the turntable's own handlers, so these run last
        // within the same event and the render sees a consistent pair
        window.addEventListener("mousemove", holdPivot);
        canvas.addEventListener("wheel", holdPivot);
        holdPivot();
        // low-cost safety net for programmatic rotations (reset button etc.)
        const rafLoop = () => {
          if (!focus3D.storyId) return;
          holdPivot();
          focus3D.raf = requestAnimationFrame(rafLoop);
        };
        rafLoop();

        // an unconnected scene (no narrative arc in or out — newly
        // created ones start life this way) gets a teal frame so it's
        // easy to spot the cards that still need wiring in. Scene→hub
        // tether arcs are what the server draws FOR unconnected scenes,
        // so they don't count as connections.
        const connectedIds = new Set();
        for (const arc of cluster.internalArcs) {
          if (arc.from === cluster.storyNodeId || arc.to === cluster.storyNodeId) continue;
          connectedIds.add(arc.from);
          connectedIds.add(arc.to);
        }

        for (const sn of cluster.scenes) {
          const card = document.createElement("a-entity");
          card.setAttribute("position", sn.position.x + " " + sn.position.y + " " + sn.position.z);
          // occlude: focus cards sit among this story's narrative arcs, so a
          // card rotated to the back must be hidden by arcs in front of it
          // (without occlude the card's depthTest is off and it always wins).
          card.setAttribute("stabilcam", "baseScale: 1; refDist: 24; maxScale: 1.5; occlude: true; depthBias: 0.8");
          card.classList.add("focus3d-card");
          card.setAttribute("data-card-scene", String(sn.sceneId));

          const backdrop = document.createElement("a-plane");
          backdrop.setAttribute("width", "2.8");
          backdrop.setAttribute("height", "1.7");
          backdrop.setAttribute("material", "color: #12151b; opacity: 0.94; transparent: true; shader: flat");
          const frame = document.createElement("a-plane");
          frame.setAttribute("width", "2.88");
          frame.setAttribute("height", "1.78");
          frame.setAttribute("position", "0 0 -0.01");
          const baseFrameMaterial = connectedIds.has(sn.id)
            ? FOCUS3D_FRAME_MATERIAL
            : FOCUS3D_FRAME_MATERIAL_UNCONNECTED;
          frame.setAttribute("material", baseFrameMaterial);

          const title = cardText(sn.title.toUpperCase() + (sn.isOpening ? "  ·  START" : ""), 0.12, "#9fb3c8", 0.72);
          const heading = cardText(sn.heading, 0.19, "#ecf0f1", 0.52);
          const excerpt = cardText((sn.excerpt || "").slice(0, 160), 0.125, "#c9d4de", 0.2);

          card.append(frame, backdrop, title, heading, excerpt);
          clusterEl?.appendChild(card) ?? turntable.appendChild(card);
          focus3D.entities.push(card);
          focus3D.cards.set(sn.sceneId, { card, sn, heading, excerpt, title, frame, baseFrameMaterial });
        }

        // CREATE (slice 3, verb 2): "+ scene" on the board → title form →
        // existing createScene API → the new card appears. The scene has
        // no image yet — hollow as a photosphere, fine as a card.
        const createPill = document.createElement("button");
        createPill.type = "button";
        createPill.className = "vsat-focus3d-create";
        createPill.textContent = "+ scene";
        createPill.addEventListener("click", () => openCreateForm3D());
        document.body.appendChild(createPill);
        focus3D.createPill = createPill;
      };

      // click a floating card (screen-space pick, same idiom as node hover)
      canvas.addEventListener("click", (e) => {
        if (!focus3D.storyId) return;
        if (dragTotal > 5) return; // a drag ending near a card is not a pick
        // "canvas" is the wrapper div: don't steal clicks that belong to
        // real controls layered over it (toolbar, "?" panel, popovers)
        if (e.target instanceof Element &&
            e.target.closest("button, a, input, textarea, [contenteditable], .vsatlatarium__usage")) return;
        const rect = canvas.getBoundingClientRect();
        const cam = sceneEl.camera;
        let best = null;
        let bestDist = 120;
        for (const [sceneId, entry] of focus3D.cards) {
          entry.card.object3D.getWorldPosition(_worldPos);
          _projected.copy(_worldPos).project(cam);
          if (_projected.z > 1) continue;
          const sx = rect.left + ((_projected.x + 1) / 2) * rect.width;
          const sy = rect.top + ((1 - _projected.y) / 2) * rect.height;
          const d = Math.hypot(e.clientX - sx, e.clientY - sy);
          if (d < bestDist) { bestDist = d; best = entry; }
        }
        if (best) {
          // capture phase: keep the pick from falling through to the
          // navigate-into-story click handler underneath
          e.stopPropagation();
          if (focus3D.connect) {
            if (best.sn.sceneId === focus3D.connect.from.sceneId) cancelConnect3D();
            else openConnectForm3D(best);
            return;
          }
          openFloatingEditor(best);
        }
      }, true);

      // CONNECT (slice 3, verb 1 — GeomView focus board): pick source card
      // (via its popover's verb) → pick target card → label form; writes an
      // ordinary [label](target) line into the source scene's draft via the
      // shared write path. Story-scoped and immediate — NOT an interpretive
      // proposal. The arc re-derives on republish; we draw it in-scene at
      // once so the board reflects the connect without a reload.
      const FOCUS3D_FRAME_MATERIAL = "color: #3c5976; opacity: 0.9; shader: flat";
      const FOCUS3D_FRAME_MATERIAL_UNCONNECTED = "color: #3fa08f; opacity: 0.9; shader: flat";
      // same derivation as the server's parseLinkTarget: scene title →
      // trimmed, whitespace→"-", lowercased
      const sceneLinkTarget = (t) => t.trim().replace(/\s+/g, "-").toLocaleLowerCase();

      // write a narrative link line from one scene to another and mirror it
      // on the board — shared by the CONNECT form and the voice verb
      const applyConnection = async (fromSn, toSn, label) => {
        const edit = window.__vsatEdit;
        if (!edit) throw new Error("edit bridge unavailable");
        const line = "[" + (label || toSn.title) + "](" + sceneLinkTarget(toSn.title) + ")";
        await edit.mutateDraftContent(fromSn.storyId, fromSn.sceneId, (content) =>
          edit.insertHotspotLine(content, fromSn.pageCount - 1, line));
        const cluster = clientData.clusters.find((c) => String(c.storyId) === focus3D.storyId);
        if (cluster && !cluster.internalArcs.some((a) => a.from === fromSn.id && a.to === toSn.id)) {
          cluster.internalArcs.push({ from: fromSn.id, to: toSn.id });
          const bow = isPlanetarium ? 0.15 : 1.2;
          const cp = localArcControlPoint(fromSn.position, toSn.position, cluster.center, bow);
          const uid = drawArc(fromSn.position, toSn.position, cp, "#fb923c", 0.8, 0.06, "internal", undefined, cluster.storyId);
          internalArcByUid.set(uid, { from: fromSn.id, to: toSn.id, storyId: String(cluster.storyId) });
        }
        // a real connection replaces any scene→hub tether visuals
        if (cluster) {
          for (const nodeId of [fromSn.id, toSn.id]) {
            const hubUid = hubArcUidByScene.get(nodeId);
            if (hubUid !== undefined) {
              for (const seg of arcSegments(hubUid)) seg.remove();
              hubArcUidByScene.delete(nodeId);
            }
          }
          refreshUnconnectedFrames(cluster);
        }
      };

      const cancelConnect3D = () => {
        const st = focus3D.connect;
        if (!st) return;
        if (st.srcEntry?.frame) st.srcEntry.frame.setAttribute("material", st.srcEntry.baseFrameMaterial || FOCUS3D_FRAME_MATERIAL);
        st.hint?.remove();
        st.form?.remove();
        focus3D.connect = null;
      };

      const beginConnect3D = (entry) => {
        cancelConnect3D();
        focus3D.connect = { from: entry.sn, srcEntry: entry, hint: null, form: null };
        entry.frame?.setAttribute("material", "color: #e8a33d; opacity: 0.95; shader: flat");
        const hint = document.createElement("div");
        hint.className = "vsat-focus3d-hint";
        hint.textContent = 'connect: click the target card — a link line lands in "' + entry.sn.title + '" (Esc cancels)';
        canvas.appendChild(hint);
        focus3D.connect.hint = hint;
      };

      const openConnectForm3D = (toEntry) => {
        const st = focus3D.connect;
        if (!st || st.form) return;
        const toSn = toEntry.sn;
        const panel = document.createElement("div");
        panel.className = "vsat-focus__card vsat-focus3d-connect";
        panel.style.cssText = "position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:10004;width:340px;cursor:default";
        const t = document.createElement("div");
        t.className = "vsat-focus__card-title";
        t.textContent = "connect: " + st.from.title + " → " + toSn.title;
        const form = document.createElement("form");
        form.className = "vsat-focus__connect-form";
        const input = document.createElement("input");
        input.value = toSn.title;
        input.placeholder = "link label";
        const err = document.createElement("p");
        err.className = "vsat-focus__card-err";
        err.hidden = true;
        const actions = document.createElement("div");
        actions.className = "vsat-focus__card-actions";
        actions.innerHTML = '<button type="button" data-cancel>Cancel</button><button type="submit" data-save>Connect</button>';
        form.append(input, err, actions);
        panel.append(t, form);
        actions.querySelector("[data-cancel]").addEventListener("click", cancelConnect3D);
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const label = input.value.trim();
          if (!label) return;
          const edit = window.__vsatEdit;
          if (!edit) { err.textContent = "edit bridge unavailable"; err.hidden = false; return; }
          actions.querySelector("[data-save]").disabled = true;
          err.hidden = true;
          try {
            await applyConnection(st.from, toSn, label);
            cancelConnect3D();
          } catch (e2) {
            err.textContent = String((e2 && e2.message) || e2);
            err.hidden = false;
            actions.querySelector("[data-save]").disabled = false;
          }
        });
        document.body.appendChild(panel);
        st.form = panel;
        input.focus();
        input.select();
      };

      // create + title + publish + board mirror — shared by the + scene
      // form and the voice CREATE verb
      const createSceneOnBoard = async (storyId, title) => {
        // createScene ignores a source body today, so the title and a
        // heading are stamped in follow-up saves before republishing
        const res = await fetch("/api/story/" + storyId + "/scene", { method: "POST" });
        if (!res.ok) {
          throw new Error(res.status === 401 || res.status === 403
            ? "you need to be signed in as this story's author"
            : "couldn't create the scene (" + res.status + ")");
        }
        const scene = await res.json();
        const base = "/api/story/" + storyId + "/scene/" + scene.id;
        const titleRes = await fetch(base + "/title", {
          method: "PUT", headers: { "content-type": "text/plain" }, body: title });
        if (!titleRes.ok) throw new Error("scene created, but couldn't set its title (" + titleRes.status + ")");
        const contentRes = await fetch(base + "/content", {
          method: "PUT", headers: { "content-type": "text/plain" }, body: "# " + title + "\n" });
        if (!contentRes.ok) throw new Error("scene created, but couldn't set its content (" + contentRes.status + ")");
        const pubRes = await fetch("/api/story/" + storyId + "/publish", { method: "POST" });
        if (!pubRes.ok) throw new Error("scene created, but couldn't republish (" + pubRes.status + ")");
        // surface the new scene as a card: extend the client-side cluster
        // (the server's spring layout only knows it after a reload) and
        // rebuild the focus board
        const cluster = clientData.clusters.find((c) => String(c.storyId) === storyId);
        if (cluster) {
          cluster.scenes.push({
            id: "story-" + cluster.storyId + "-scene-" + scene.id,
            sceneId: scene.id,
            storyId: cluster.storyId,
            title,
            isOpening: false,
            pageCount: 1,
            heading: title,
            excerpt: "",
            position: {
              x: cluster.center.x,
              y: cluster.center.y + cluster.localRadius * 1.15,
              z: cluster.center.z,
            },
          });
        }
        enterFocus3D(storyId);
        return scene;
      };

      const openCreateForm3D = () => {
        if (!focus3D.storyId || focus3D.createForm) return;
        const storyId = focus3D.storyId;
        const panel = document.createElement("div");
        panel.className = "vsat-focus__card vsat-focus3d-createform";
        panel.style.cssText = "position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:10004;width:340px;cursor:default";
        const t = document.createElement("div");
        t.className = "vsat-focus__card-title";
        t.textContent = "new scene";
        const form = document.createElement("form");
        form.className = "vsat-focus__connect-form";
        const input = document.createElement("input");
        input.placeholder = "scene title";
        const err = document.createElement("p");
        err.className = "vsat-focus__card-err";
        err.hidden = true;
        const actions = document.createElement("div");
        actions.className = "vsat-focus__card-actions";
        actions.innerHTML = '<button type="button" data-cancel>Cancel</button><button type="submit" data-save>Create</button>';
        form.append(input, err, actions);
        panel.append(t, form);
        const close = () => { panel.remove(); focus3D.createForm = null; };
        actions.querySelector("[data-cancel]").addEventListener("click", close);
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const title = input.value.trim();
          if (!title) return;
          actions.querySelector("[data-save]").disabled = true;
          err.hidden = true;
          try {
            await createSceneOnBoard(storyId, title);
            close();
          } catch (e2) {
            err.textContent = String((e2 && e2.message) || e2);
            err.hidden = false;
            actions.querySelector("[data-save]").disabled = false;
          }
        });
        document.body.appendChild(panel);
        focus3D.createForm = panel;
        input.focus();
      };

      // recompute which cards are unconnected (teal) from the cluster's
      // current arcs — used after connect, arc delete, and scene delete
      const refreshUnconnectedFrames = (cluster) => {
        const connected = new Set();
        for (const a of cluster.internalArcs) {
          if (a.from === cluster.storyNodeId || a.to === cluster.storyNodeId) continue;
          connected.add(a.from);
          connected.add(a.to);
        }
        for (const entry of focus3D.cards.values()) {
          const base = connected.has(entry.sn.id)
            ? FOCUS3D_FRAME_MATERIAL
            : FOCUS3D_FRAME_MATERIAL_UNCONNECTED;
          entry.baseFrameMaterial = base;
          if (!(focus3D.connect && focus3D.connect.srcEntry === entry)) {
            entry.frame.setAttribute("material", base);
          }
        }
      };

      // REMOVE (slice 3, verb 3): hovering a narrative arc while focused
      // marks it as the CURRENT link — a chip names it (source → target,
      // link labels once the published story loads) with a Delete
      // affordance, so you see exactly what you're deleting before you
      // do. Delete strips every link line in the source scene that
      // resolves to the target scene (the removeLine transform through
      // the shared write path) and republishes; the arc disappears.
      // Sticky: the current link persists until another arc is hovered,
      // Esc, or focus exit. Inter-story arcs keep their steward-gated
      // RETIRE flow — this touches narrative arcs only.
      const arcCurrent = { uid: null, chip: null, samples: new Map() };

      const arcSegments = (uid) =>
        [...turntable.querySelectorAll('.arc-segment[data-arc-uid="' + uid + '"]')];

      const setArcHighlight = (uid, on) => {
        for (const seg of arcSegments(uid)) {
          const color = on ? "#ffd27f" : (seg.getAttribute("data-arc-color") || "#fb923c");
          const opacity = on ? 1 : Number(seg.getAttribute("data-arc-opacity") || 0.8);
          seg.setAttribute("material", "color: " + color + "; opacity: " + opacity + "; transparent: true; shader: flat");
        }
      };

      const clearCurrentArc = () => {
        if (arcCurrent.uid !== null) setArcHighlight(arcCurrent.uid, false);
        arcCurrent.uid = null;
        arcCurrent.chip?.remove();
        arcCurrent.chip = null;
      };

      const removeInternalArcClientSide = (uid, meta, cluster) => {
        for (const seg of arcSegments(uid)) seg.remove();
        internalArcByUid.delete(uid);
        arcCurrent.samples.delete(uid);
        cluster.internalArcs = cluster.internalArcs.filter(
          (a) => !(a.from === meta.from && a.to === meta.to),
        );
        refreshUnconnectedFrames(cluster);
      };

      const showCurrentArcChip = (uid, atClientX, atClientY) => {
        const meta = internalArcByUid.get(uid);
        const cluster = clientData.clusters.find((c) => String(c.storyId) === focus3D.storyId);
        const fromSn = cluster?.scenes.find((s) => s.id === meta.from);
        const toSn = cluster?.scenes.find((s) => s.id === meta.to);
        if (!fromSn || !toSn) return;
        const chip = document.createElement("div");
        chip.className = "vsat-focus3d-linkchip";
        // Delete first, under the pointer: in an edge-dense model,
        // travelling to a fixed chip position crosses other arcs and the
        // sticky pick re-targets before you arrive (QA, 2026-08-16). The
        // annotation runs out to the right.
        const del = document.createElement("button");
        del.type = "button";
        del.textContent = "Delete";
        const label = document.createElement("span");
        label.textContent = fromSn.title + " → " + toSn.title;
        const err = document.createElement("span");
        err.className = "vsat-focus3d-linkchip-err";
        chip.append(del, label, err);
        canvas.appendChild(chip);
        // position at the pointer (wrapper-relative), clamped to the canvas
        const rect = canvas.getBoundingClientRect();
        let left = atClientX - rect.left + 6;
        let top = atClientY - rect.top + 6;
        left = Math.max(6, Math.min(left, rect.width - chip.offsetWidth - 6));
        top = Math.max(6, Math.min(top, rect.height - chip.offsetHeight - 6));
        chip.style.left = left + "px";
        chip.style.top = top + "px";
        arcCurrent.chip = chip;

        // the target scene's link targets, from the server's own
        // resolution (cluster.linkTargets) — the exact mapping the arc
        // was derived with. The title-derived target is added on top:
        // it's what CONNECT writes, and it's the only inbound form a
        // scene created after page load can have.
        const targets = new Set(
          (cluster.linkTargets || [])
            .filter(([, sid]) => sid === toSn.sceneId)
            .map(([target]) => target),
        );
        targets.add(sceneLinkTarget(toSn.title));

        // name the actual line labels once the source draft loads
        fetch("/api/story/" + cluster.storyId + "/scene/" + fromSn.sceneId)
          .then((r) => (r.ok ? r.json() : null))
          .then((draft) => {
            if (!draft) return;
            const labels = [];
            for (const line of (draft.content || "").split("\n")) {
              const m = /^\s*\[([^\]]*)\]\(\s*([^)\s@]+)/.exec(line);
              if (m && targets.has(m[2])) labels.push(m[1]);
            }
            if (labels.length) {
              label.textContent = '"' + labels.join('", "') + '" → ' + toSn.title + " · from " + fromSn.title;
            }
          })
          .catch(() => undefined);

        del.addEventListener("click", async () => {
          const edit = window.__vsatEdit;
          if (!edit) { err.textContent = "edit bridge unavailable"; return; }
          del.disabled = true;
          err.textContent = "";
          try {
            await edit.mutateDraftContent(cluster.storyId, fromSn.sceneId, (content) =>
              content
                .split("\n")
                .filter((line) => {
                  const m = /^\s*\[[^\]]*\]\(\s*([^)\s@]+)/.exec(line);
                  return !(m && targets.has(m[1]));
                })
                .join("\n"));
            removeInternalArcClientSide(uid, meta, cluster);
            clearCurrentArc();
          } catch (e2) {
            err.textContent = String((e2 && e2.message) || e2);
            del.disabled = false;
          }
        });
      };

      const pickCurrentArc = (e) => {
        if (!focus3D.storyId || focus3D.connect || focus3D.createForm || focus3D.removeForm) return;
        if (e.target instanceof Element &&
            e.target.closest("button, a, input, textarea, [contenteditable], .vsat-focus__card, .vsat-focus3d-linkchip")) return;
        const rect = canvas.getBoundingClientRect();
        const cam = sceneEl.camera;
        // cards take precedence over arcs: crossing an arc en route to a
        // card kept spawning the chip under the pointer, eating the card's
        // click (operator QA). Arcs pick only in empty space — same 120px
        // radius as the card click pick — and reaching a card dismisses
        // the current chip.
        for (const entry of focus3D.cards.values()) {
          entry.card.object3D.getWorldPosition(_worldPos);
          _projected.copy(_worldPos).project(cam);
          if (_projected.z > 1) continue;
          const sx = rect.left + ((_projected.x + 1) / 2) * rect.width;
          const sy = rect.top + ((1 - _projected.y) / 2) * rect.height;
          if (Math.hypot(e.clientX - sx, e.clientY - sy) < 120) {
            if (arcCurrent.uid !== null) clearCurrentArc();
            return;
          }
        }
        let best = null;
        let bestDist = 30;
        for (const [uid, meta] of internalArcByUid) {
          if (meta.storyId !== String(focus3D.storyId)) continue;
          let samples = arcCurrent.samples.get(uid);
          if (!samples) {
            samples = arcSegments(uid).filter((_, i) => i % 6 === 0);
            arcCurrent.samples.set(uid, samples);
          }
          for (const seg of samples) {
            if (!seg.object3D) continue;
            seg.object3D.getWorldPosition(_worldPos);
            _projected.copy(_worldPos).project(cam);
            if (_projected.z > 1) continue;
            const sx = rect.left + ((_projected.x + 1) / 2) * rect.width;
            const sy = rect.top + ((1 - _projected.y) / 2) * rect.height;
            const d = Math.hypot(e.clientX - sx, e.clientY - sy);
            if (d < bestDist) { bestDist = d; best = uid; }
          }
        }
        if (best !== null && best !== arcCurrent.uid) {
          clearCurrentArc();
          arcCurrent.uid = best;
          setArcHighlight(best, true);
          showCurrentArcChip(best, e.clientX, e.clientY);
        }
      };
      window.addEventListener("mousemove", pickCurrentArc);

      // REMOVE, scene flavour: the popover's "− remove" verb — deletes the
      // scene itself after an explicit confirmation that counts the
      // narrative arcs going with it.
      const openRemoveSceneForm3D = (entry) => {
        if (!focus3D.storyId || focus3D.removeForm) return;
        const sn = entry.sn;
        const cluster = clientData.clusters.find((c) => String(c.storyId) === focus3D.storyId);
        if (!cluster) return;
        const touching = cluster.internalArcs.filter(
          (a) => a.from === sn.id || a.to === sn.id,
        ).length;
        const panel = document.createElement("div");
        panel.className = "vsat-focus__card vsat-focus3d-removeform";
        panel.style.cssText = "position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:10004;width:340px;cursor:default";
        const t = document.createElement("div");
        t.className = "vsat-focus__card-title";
        t.textContent = "remove scene";
        const msg = document.createElement("div");
        msg.className = "vsat-focus__card-body";
        msg.textContent =
          'Delete "' + sn.title + '"' +
          (touching ? " and its " + touching + " narrative arc" + (touching > 1 ? "s" : "") : "") +
          "? This cannot be undone.";
        const err = document.createElement("p");
        err.className = "vsat-focus__card-err";
        err.hidden = true;
        const actions = document.createElement("div");
        actions.className = "vsat-focus__card-actions";
        actions.innerHTML = '<button type="button" data-cancel>Cancel</button><button type="button" data-save>Delete</button>';
        panel.append(t, msg, err, actions);
        const close = () => { panel.remove(); focus3D.removeForm = null; };
        actions.querySelector("[data-cancel]").addEventListener("click", close);
        actions.querySelector("[data-save]").addEventListener("click", async (e) => {
          e.target.disabled = true;
          err.hidden = true;
          try {
            const res = await fetch("/api/story/" + cluster.storyId + "/scene/" + sn.sceneId, { method: "DELETE" });
            if (!res.ok) {
              throw new Error(res.status === 401 || res.status === 403
                ? "you need to be signed in as this story's author"
                : "couldn't delete the scene (" + res.status + ")");
            }
            const pubRes = await fetch("/api/story/" + cluster.storyId + "/publish", { method: "POST" });
            if (!pubRes.ok) throw new Error("deleted, but couldn't republish (" + pubRes.status + ")");
            // client mirror: the scene's arcs (incl. its hub tether),
            // node (label is a child), card
            for (const [uid, meta] of [...internalArcByUid]) {
              if (meta.storyId === String(cluster.storyId) && (meta.from === sn.id || meta.to === sn.id)) {
                for (const seg of arcSegments(uid)) seg.remove();
                internalArcByUid.delete(uid);
                arcCurrent.samples.delete(uid);
              }
            }
            const hubUid = hubArcUidByScene.get(sn.id);
            if (hubUid !== undefined) {
              for (const seg of arcSegments(hubUid)) seg.remove();
              hubArcUidByScene.delete(sn.id);
            }
            clearCurrentArc();
            cluster.internalArcs = cluster.internalArcs.filter(
              (a) => a.from !== sn.id && a.to !== sn.id,
            );
            cluster.scenes = cluster.scenes.filter((s) => s.id !== sn.id);
            document.querySelector('.scene-node[data-scene-id="' + sn.id + '"]')?.remove();
            close();
            enterFocus3D(cluster.storyId);
          } catch (e2) {
            err.textContent = String((e2 && e2.message) || e2);
            err.hidden = false;
            e.target.disabled = false;
          }
        });
        document.body.appendChild(panel);
        focus3D.removeForm = panel;
      };

      // --- VOICE demo mode (M-voice-board, Whisper-URL direct) ---------
      // Hold V to talk while armed; verbs act on the card nearest the
      // pointer ("this card") or the current hovered arc ("this link").
      // Capture → 16 kHz WAV → POST {vsat-whisper-url}/transcribe →
      // parseVoiceUtterance → the SAME apply paths as the pointer verbs.
      // This is local authoring under the author's own session; the
      // relay/provenance story (M-voice-board slices 2-4) is separate.
      const vox = window.__vsatVoice;
      const voice = {
        armed: false, ctx: null, node: null, stream: null,
        frames: [], recording: false, dictating: null, chip: null,
        lastMouse: { x: 0, y: 0 },
      };
      const whisperBase = () =>
        (localStorage.getItem("vsat-whisper-url") || "http://localhost:8081").replace(/\/+$/, "");
      const voiceBtn = document.getElementById("vsat-toggle-voice");

      const setVoiceChip = (text, state) => {
        if (!voice.chip) {
          voice.chip = document.createElement("div");
          voice.chip.className = "vsat-voice-chip";
          canvas.appendChild(voice.chip);
        }
        voice.chip.textContent = text;
        voice.chip.dataset.state = state || "info";
      };
      const clearVoiceChip = () => { voice.chip?.remove(); voice.chip = null; };

      window.addEventListener("mousemove", (e) => {
        voice.lastMouse.x = e.clientX;
        voice.lastMouse.y = e.clientY;
      });

      const focusedCluster = () =>
        clientData.clusters.find((c) => String(c.storyId) === focus3D.storyId);

      // "this card" = the card nearest the pointer, generously
      const deixisEntry = () => {
        if (!focus3D.storyId) return null;
        const rect = canvas.getBoundingClientRect();
        const cam = sceneEl.camera;
        let best = null;
        let bestD = 260;
        for (const entry of focus3D.cards.values()) {
          entry.card.object3D.getWorldPosition(_worldPos);
          _projected.copy(_worldPos).project(cam);
          if (_projected.z > 1) continue;
          const sx = rect.left + ((_projected.x + 1) / 2) * rect.width;
          const sy = rect.top + ((1 - _projected.y) / 2) * rect.height;
          const d = Math.hypot(voice.lastMouse.x - sx, voice.lastMouse.y - sy);
          if (d < bestD) { bestD = d; best = entry; }
        }
        return best;
      };

      const armVoice = async () => {
        try {
          voice.stream = await navigator.mediaDevices.getUserMedia({
            audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true },
          });
          voice.ctx = new AudioContext({ sampleRate: 16000 });
          const source = voice.ctx.createMediaStreamSource(voice.stream);
          voice.node = voice.ctx.createScriptProcessor(4096, 1, 1);
          voice.node.onaudioprocess = (e) => {
            if (voice.recording) voice.frames.push(new Float32Array(e.inputBuffer.getChannelData(0)));
          };
          source.connect(voice.node);
          voice.node.connect(voice.ctx.destination);
          voice.armed = true;
          voiceBtn.classList.add("vsatlatarium__btn--active");
          voiceBtn.setAttribute("aria-pressed", "true");
          setVoiceChip("voice armed — hold V and speak: new card (called …) · connect this card to … · remove this link / card · edit this card · done", "info");
        } catch (e2) {
          setVoiceChip("microphone unavailable: " + ((e2 && e2.message) || e2), "err");
        }
      };
      const disarmVoice = () => {
        voice.armed = false;
        voice.recording = false;
        voice.frames = [];
        voice.dictating = null;
        voice.node?.disconnect();
        voice.ctx?.close().catch(() => undefined);
        voice.stream?.getTracks().forEach((t) => t.stop());
        voice.node = null; voice.ctx = null; voice.stream = null;
        voiceBtn?.classList.remove("vsatlatarium__btn--active");
        voiceBtn?.setAttribute("aria-pressed", "false");
        clearVoiceChip();
      };
      voiceBtn?.addEventListener("click", () => (voice.armed ? disarmVoice() : armVoice()));

      const encodeWav = (frames, rate) => {
        let len = 0;
        for (const f of frames) len += f.length;
        const pcm = new Int16Array(len);
        let o = 0;
        for (const f of frames) {
          for (let i = 0; i < f.length; i++) {
            const s = Math.max(-1, Math.min(1, f[i]));
            pcm[o++] = s < 0 ? s * 0x8000 : s * 0x7fff;
          }
        }
        const buf = new ArrayBuffer(44 + pcm.length * 2);
        const v = new DataView(buf);
        const ws = (off, str) => { for (let i = 0; i < str.length; i++) v.setUint8(off + i, str.charCodeAt(i)); };
        ws(0, "RIFF"); v.setUint32(4, 36 + pcm.length * 2, true); ws(8, "WAVE"); ws(12, "fmt ");
        v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);
        v.setUint32(24, rate, true); v.setUint32(28, rate * 2, true); v.setUint16(32, 2, true); v.setUint16(34, 16, true);
        ws(36, "data"); v.setUint32(40, pcm.length * 2, true);
        new Int16Array(buf, 44).set(pcm);
        return buf;
      };

      const applyIntent = async (intent) => {
        const cluster = focusedCluster();
        switch (intent.kind) {
          case "create": {
            if (!cluster) { setVoiceChip("focus a story first (right-click one)", "err"); return; }
            setVoiceChip("creating card…", "busy");
            await createSceneOnBoard(focus3D.storyId, intent.title || "A Scene");
            setVoiceChip('created "' + (intent.title || "A Scene") + '"', "ok");
            return;
          }
          case "connect": {
            if (!cluster) { setVoiceChip("focus a story first", "err"); return; }
            const from = deixisEntry();
            if (!from) { setVoiceChip("point at the source card, then speak", "err"); return; }
            const match = vox.matchSceneTitle(intent.targetPhrase, cluster.scenes.map((s) => s.title));
            if (match.kind === "none") { setVoiceChip('no scene matches "' + intent.targetPhrase + '"', "err"); return; }
            if (match.kind === "ambiguous") { setVoiceChip('"' + intent.targetPhrase + '" is ambiguous: ' + match.candidates.join(" · "), "err"); return; }
            const toSn = cluster.scenes.find((s) => s.title === match.title);
            if (!toSn || toSn.id === from.sn.id) { setVoiceChip("can't connect a card to itself", "err"); return; }
            setVoiceChip("connecting " + from.sn.title + " → " + toSn.title + "…", "busy");
            await applyConnection(from.sn, toSn, toSn.title);
            setVoiceChip(from.sn.title + " → " + toSn.title + " ✓", "ok");
            return;
          }
          case "remove-link": {
            const btn = arcCurrent.chip?.querySelector("button");
            if (arcCurrent.uid === null || !btn) { setVoiceChip("hover the link first, then speak", "err"); return; }
            btn.click();
            setVoiceChip("removing the current link…", "ok");
            return;
          }
          case "remove-card": {
            const entry = deixisEntry();
            if (!entry) { setVoiceChip("point at the card, then speak", "err"); return; }
            openRemoveSceneForm3D(entry);
            setVoiceChip('say "confirm" to delete "' + entry.sn.title + '", or "cancel"', "info");
            return;
          }
          case "confirm": {
            const save = focus3D.removeForm?.querySelector("[data-save]");
            if (save) { save.click(); setVoiceChip("confirmed", "ok"); }
            else setVoiceChip("nothing to confirm", "err");
            return;
          }
          case "cancel": {
            const cancelBtn = focus3D.removeForm?.querySelector("[data-cancel]");
            if (cancelBtn) { cancelBtn.click(); setVoiceChip("cancelled", "ok"); }
            else if (voice.dictating) { voice.dictating = null; setVoiceChip("dictation cancelled", "ok"); }
            else setVoiceChip("nothing to cancel", "err");
            return;
          }
          case "edit-card": {
            const entry = deixisEntry();
            if (!entry) { setVoiceChip("point at the card, then speak", "err"); return; }
            voice.dictating = entry;
            setVoiceChip('dictating into "' + entry.sn.title + '" — each utterance becomes a paragraph; say "done" to finish', "info");
            return;
          }
          case "done": {
            if (voice.dictating) {
              const t = voice.dictating.sn.title;
              voice.dictating = null;
              setVoiceChip('finished dictating into "' + t + '"', "ok");
            }
            return;
          }
          default: {
            setVoiceChip('heard, not a command: "' + intent.transcript.slice(0, 80) + '"', "err");
            console.info("[voice] refused:", intent);
          }
        }
      };

      const handleTranscript = async (text) => {
        if (voice.dictating) {
          const intents = vox.parseVoiceUtterance(text);
          if (intents.length && intents.every((i) => i.kind === "done" || i.kind === "cancel")) {
            await applyIntent(intents[0]);
            return;
          }
          const target = voice.dictating;
          const cluster = focusedCluster();
          if (!cluster) { setVoiceChip("focus lost — dictation ended", "err"); voice.dictating = null; return; }
          setVoiceChip("writing…", "busy");
          await window.__vsatEdit.mutateDraftContent(cluster.storyId, target.sn.sceneId, (content) =>
            content.replace(/\s*$/, "") + "\n\n" + text + "\n");
          setVoiceChip('“' + text.slice(0, 60) + (text.length > 60 ? "…" : "") + '” → ' + target.sn.title + ' — say "done" to finish', "ok");
          return;
        }
        for (const intent of vox.parseVoiceUtterance(text)) {
          try {
            await applyIntent(intent);
          } catch (e2) {
            setVoiceChip("failed: " + ((e2 && e2.message) || e2), "err");
            return;
          }
        }
      };

      const voiceKeyGuard = (e) =>
        e.target instanceof Element && e.target.closest("input, textarea, [contenteditable]");
      window.addEventListener("keydown", (e) => {
        if (!voice.armed || e.repeat || e.key.toLowerCase() !== "v" || voiceKeyGuard(e)) return;
        voice.recording = true;
        voice.frames = [];
        setVoiceChip(voice.dictating ? "recording (dictation)…" : "recording…", "rec");
      });
      window.addEventListener("keyup", async (e) => {
        if (!voice.armed || e.key.toLowerCase() !== "v" || !voice.recording) return;
        voice.recording = false;
        const frames = voice.frames;
        voice.frames = [];
        const rate = (voice.ctx && voice.ctx.sampleRate) || 16000;
        const seconds = frames.reduce((n, f) => n + f.length, 0) / rate;
        if (seconds < 0.4) { setVoiceChip("(too short — keep V held while speaking)", "err"); return; }
        setVoiceChip("transcribing " + seconds.toFixed(1) + "s…", "busy");
        try {
          const res = await fetch(whisperBase() + "/transcribe?model=large-v3-turbo&ac=512&greedy=0", {
            method: "POST",
            headers: { "Content-Type": "audio/wav" },
            body: encodeWav(frames, rate),
          });
          if (!res.ok) throw new Error("transcribe " + res.status);
          const data = await res.json();
          const text = (data.text || "").trim();
          if (!text) { setVoiceChip("(heard nothing)", "err"); return; }
          await handleTranscript(text);
        } catch (e2) {
          setVoiceChip("voice error: " + ((e2 && e2.message) || e2) + " — whisper tunnel up? (localStorage vsat-whisper-url)", "err");
        }
      });

      const openFloatingEditor = (entry) => {
        if (document.querySelector(".vsat-focus__card--float")) return;
        const sn = entry.sn;
        const panel = document.createElement("div");
        panel.className = "vsat-focus__card vsat-focus__card--float";
        panel.style.cssText = "position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:10004;width:340px";
        const t = document.createElement("div");
        t.className = "vsat-focus__card-title";
        t.textContent = sn.title;
        const h = document.createElement("div");
        h.className = "vsat-focus__card-heading";
        h.setAttribute("data-h", "");
        h.textContent = sn.heading || "";
        const b = document.createElement("div");
        b.className = "vsat-focus__card-body";
        b.setAttribute("data-b", "");
        b.textContent = sn.excerpt || "";
        const verbs = document.createElement("div");
        verbs.className = "vsat-focus__card-verbs";
        const connectBtn = document.createElement("button");
        connectBtn.type = "button";
        connectBtn.textContent = "⤳ connect";
        connectBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          // dropping the editing class hands the popover to the editor's
          // MutationObserver below, which syncs the card and removes it
          panel.classList.remove("vsat-focus__card--editing");
          beginConnect3D(entry);
        });
        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.textContent = "− remove";
        removeBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          panel.classList.remove("vsat-focus__card--editing");
          openRemoveSceneForm3D(entry);
        });
        verbs.append(connectBtn, removeBtn);
        panel.append(t, h, b, verbs);
        document.body.appendChild(panel);
        openCardEditor(sn, panel);
        // when the editor chrome goes away (save or cancel), sync the 3D
        // card's text and remove the popover
        const watch = new MutationObserver(() => {
          if (!panel.classList.contains("vsat-focus__card--editing")) {
            watch.disconnect();
            entry.heading.setAttribute("troika-text", cardTroikaValue(sn.heading, 0.19, "#ecf0f1"));
            entry.excerpt.setAttribute("troika-text", cardTroikaValue((sn.excerpt || "").slice(0, 160), 0.125, "#c9d4de"));
            panel.remove();
          }
        });
        watch.observe(panel, { attributes: true, attributeFilter: ["class"] });
      };

      // right-click enters focus on the story under the cursor; right-click
      // on empty space (or Esc) leaves it
      canvas.addEventListener("contextmenu", (e) => {
        // same wrapper-div caveat as the click pick above
        if (e.target instanceof Element &&
            e.target.closest("button, a, input, textarea, [contenteditable], .vsatlatarium__usage")) return;
        const hit = findNearest(e.clientX, e.clientY);
        let storyId = hit ? hit.getAttribute("data-story-id") : null;
        if (!storyId) {
          // generous fallback: the nearest story hub within 350px — the
          // precise 100px node radius is too small a target for a human
          // right-click
          const rect = canvas.getBoundingClientRect();
          const cam = sceneEl.camera;
          let bestDist = 350;
          for (const el of document.querySelectorAll(".scene-node")) {
            const id = el.getAttribute("data-scene-id") || "";
            if (!id.endsWith("-hub") || !el.object3D || !cam) continue;
            el.object3D.getWorldPosition(_worldPos);
            _projected.copy(_worldPos).project(cam);
            if (_projected.z > 1) continue;
            const sx = rect.left + ((_projected.x + 1) / 2) * rect.width;
            const sy = rect.top + ((1 - _projected.y) / 2) * rect.height;
            const d = Math.hypot(e.clientX - sx, e.clientY - sy);
            if (d < bestDist) {
              bestDist = d;
              storyId = el.getAttribute("data-story-id");
            }
          }
        }
        if (storyId) {
          enterFocus(storyId);
        } else if (focusState.els || focus3D.storyId) {
          exitFocus();
          exitFocus3D();
        }
      });
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          // an open form, in-flight connect, or current-link chip
          // swallows the first Esc; focus stays up
          if (focus3D.createForm) {
            focus3D.createForm.remove();
            focus3D.createForm = null;
            return;
          }
          if (focus3D.removeForm) {
            focus3D.removeForm.remove();
            focus3D.removeForm = null;
            return;
          }
          if (focus3D.connect && focus3D.connect.from) {
            cancelConnect3D();
            return;
          }
          if (arcCurrent.uid !== null) {
            clearCurrentArc();
            return;
          }
          exitFocus();
          exitFocus3D();
        }
      });
    };

    if (sceneEl.hasLoaded) {
      setTimeout(() => {
        initInteraction();
        updateGeomViewLabelMode();
      }, 500);
    } else {
      sceneEl.addEventListener("loaded", () =>
        setTimeout(() => {
          initInteraction();
          updateGeomViewLabelMode();
        }, 500)
      );
    }

    // --- Story list: rotate turntable to face cluster toward camera ---
    const _facingFrom = new THREE.Vector3();
    // The camera always looks down -Z. In GeomView it sits at +Z looking
    // back at the origin, so a cluster "facing the camera" belongs at +Z;
    // in the planetarium the camera is near the origin looking INTO the
    // -Z dome wall, so the cluster must rotate to -Z instead.
    const _facingTo = new THREE.Vector3(0, 0, isPlanetarium ? -1 : 1);
    document.querySelectorAll(".vsatlatarium__story").forEach((button) => {
      button.addEventListener("click", () => {
        const storyId = Number(button.getAttribute("data-story-id"));
        const cluster = clientData.clusters.find((c) => c.storyId === storyId);
        if (!cluster) return;
        const c = cluster.center;
        // Build a quaternion that rotates the cluster's centre direction
        // onto the camera's forward axis (+Z), regardless of the
        // turntable's current orientation.
        _facingFrom.set(c.x, c.y, c.z).normalize();
        if (_facingFrom.lengthSq() < 1e-6) _facingFrom.set(0, 0, 1);
        turntableQuat.setFromUnitVectors(_facingFrom, _facingTo);
        // Move camera partway toward the cluster
        camZ = isPlanetarium ? -12 : 18;
        applyTransform();
      });
    });

    // --- VR mode (Quest 2 / WebXR) ---
    const vrOverlays = [
      document.querySelector(".vsatlatarium__toolbar"),
      document.querySelector(".vsatlatarium__panel"),
    ];

    let vrActive = false;

    sceneEl.addEventListener("enter-vr", () => {
      vrActive = true;
      // Hide HTML overlays — they don't render inside WebXR
      vrOverlays.forEach((el) => { if (el) el.style.display = "none"; });
      // Expand canvas to fill viewport (remove sidebar grid)
      const content = document.querySelector(".vsatlatarium__content");
      if (content) content.style.gridTemplateColumns = "1fr";

      // Enable look-controls so the VR headset pose is applied to the camera
      const cam = document.querySelector("a-camera");
      if (cam) cam.setAttribute("look-controls", "enabled: true");

      // Browser-VR fallback (no headset): A-Frame's fullscreen canvas hides
      // the OS cursor by default. Force it back so the user has visible
      // mouse feedback over the constellation.
      const canvasEl = document.querySelector(".a-canvas");
      if (canvasEl) canvasEl.style.cursor = "default";

      // Disable frustum culling on turntable children — stereo VR cameras
      // can incorrectly cull small objects (nodes, arcs) while large-bounding-
      // sphere objects (particles) survive
      if (turntable?.object3D) {
        turntable.object3D.traverse((child) => {
          if (child.isMesh || child.isLine || child.isPoints) {
            child.frustumCulled = false;
          }
        });
      }

      initVRInteraction();
    });

    sceneEl.addEventListener("exit-vr", () => {
      vrActive = false;
      vrOverlays.forEach((el) => { if (el) el.style.display = ""; });
      const content = document.querySelector(".vsatlatarium__content");
      if (content) content.style.gridTemplateColumns = "";

      // Restore desktop camera mode (turntable controls, no look-controls)
      const cam = document.querySelector("a-camera");
      if (cam) cam.setAttribute("look-controls", "enabled: false");

      // Restore canvas cursor management to the desktop hover code
      const canvasEl = document.querySelector(".a-canvas");
      if (canvasEl) canvasEl.style.cursor = "";

      // Re-enable frustum culling for desktop performance
      if (turntable?.object3D) {
        turntable.object3D.traverse((child) => {
          if (child.isMesh || child.isLine || child.isPoints) {
            child.frustumCulled = true;
          }
        });
      }
    });

    let vrInteractionReady = false;

    // Find the .scene-node ancestor for any element hit by the VR raycaster
    const findSceneNode = (el) => {
      while (el) {
        if (el.classList?.contains("scene-node")) return el;
        el = el.parentEl || el.parentNode;
      }
      return null;
    };

    const initVRInteraction = () => {
      if (vrInteractionReady) return;
      vrInteractionReady = true;

      // Add large invisible hit spheres around each node — big enough to
      // cover the nearby label text too, so pointing at a title works.
      document.querySelectorAll(".scene-node").forEach((node) => {
        const hitarea = document.createElement("a-entity");
        hitarea.classList.add("vr-hitarea");
        hitarea.setAttribute("geometry", "primitive: sphere; radius: 3");
        hitarea.setAttribute("material", "opacity: 0; transparent: true; depthWrite: false");
        hitarea.setAttribute("data-story-id", node.getAttribute("data-story-id") || "");
        node.appendChild(hitarea);
      });

      // Listen on all .vr-hitarea elements
      document.querySelectorAll(".vr-hitarea").forEach((hitarea) => {
        // Find associated scene-node (direct parent for node hitareas,
        // or hub node in parent cluster for label hitareas)
        const sceneNode = findSceneNode(hitarea)
          || (() => {
            const storyId = hitarea.getAttribute("data-story-id");
            if (!storyId) return null;
            return document.querySelector(
              `.story-cluster[data-story-id="${storyId}"] > .scene-node`
            );
          })();

        hitarea.addEventListener("mouseenter", () => {
          if (!vrActive) return;
          if (sceneNode) { highlightNode(sceneNode); showInfo(sceneNode); }
        });

        hitarea.addEventListener("mouseleave", () => {
          if (!vrActive) return;
          highlightNode(null);
          if (infoEl) infoEl.innerHTML = "";
        });

        hitarea.addEventListener("click", () => {
          if (!vrActive) return;
          if (dragTotal > 5) return;
          const storyId = hitarea.getAttribute("data-story-id");
          if (storyId) window.location.href = "/story/" + storyId;
        });
      });

      // Thumbstick rotation — same trackball composition as the
      // mouse-drag path, just driven by joystick deflection.
      const _vrAxis = new THREE.Vector3();
      const _vrDelta = new THREE.Quaternion();
      const onThumbstick = (evt) => {
        const { x, y } = evt.detail;
        if (Math.abs(x) < 0.15 && Math.abs(y) < 0.15) return; // dead zone
        const len = Math.hypot(x, y);
        // Same screen-space → world axis mapping as mouse drag.
        _vrAxis.set(y, x, 0).normalize();
        const angle = len * 0.04 * dragSign; // tuned for thumbstick units
        _vrDelta.setFromAxisAngle(_vrAxis, angle);
        turntableQuat.premultiply(_vrDelta).normalize();
        applyTransform();
      };

      const rHand = document.getElementById("vr-right-hand");
      const lHand = document.getElementById("vr-left-hand");
      if (rHand) rHand.addEventListener("thumbstickmoved", onThumbstick);
      if (lHand) lHand.addEventListener("thumbstickmoved", onThumbstick);
    };

    // --- Particle drift animation (must be after all let declarations) ---
    const animateParticles = () => {
      requestAnimationFrame(animateParticles);
      if (!particles || vaporLevel < 0.05) return;
      particles.rotation.y += 0.00004;
      particles.rotation.x += 0.00001;
    };
    animateParticles();
  </script>

<script>
  // Bridge the shared authoring write-path into the inline planetarium
  // script (which is is:inline and cannot import modules itself).
  import QRCode from "qrcode";

  import {
    insertHotspotLine,
    mutateDraftContent,
    replaceSectionText,
  } from "@components/story/published/placeHotspot";
  import {
    buildVoicePrompt,
    matchSceneTitle,
    parseVoiceUtterance,
  } from "@domain/voice/parseVoiceIntent";
  (window as any).__vsatEdit = {
    insertHotspotLine,
    mutateDraftContent,
    replaceSectionText,
  };
  (window as any).__vsatVoice = {
    buildVoicePrompt,
    matchSceneTitle,
    parseVoiceUtterance,
  };
  (window as any).__vsatQR = QRCode;
</script>

