---
import ImportAFrameScripts from "@components/story/published/aframe/ImportAFrameScripts.astro";
import FlatStory from "@components/story/published/flat/FlatStory.astro";
import PublishedStory from "@components/story/published/PublishedStory.astro";
import { ErrorCodes } from "@domain/error/errorCode";
import toStoryId from "@domain/story/toStoryId";

const storyId = toStoryId(Astro.params.storyId);

if (!storyId) {
  return Astro.redirect(`/author/story?err=${ErrorCodes.StoryNotFound}`);
}

const { i18n, repositoryStory, repositoryStoryLink } = Astro.locals.environment<
  App.WithI18N & App.WithStoryRepository & App.WithStoryLinkRepository
>();

const story = await repositoryStory.getPublishedStory(storyId);

if (!story) {
  return Astro.redirect(`/author/story?err=${ErrorCodes.StoryNotFound}`);
}

// How to present the scenes: ?view= overrides, otherwise the story's
// persisted mode picks the default. "flat" and "poster" render without the
// photosphere; "poster" hangs the flat photo in A-Frame space.
const requestedView = Astro.url.searchParams.get("view");
const view =
  requestedView === "flat" || requestedView === "poster"
    ? requestedView
    : requestedView === "360"
      ? "360"
      : story.mode === "2d"
        ? "flat"
        : "360";
const layout =
  Astro.url.searchParams.get("layout") === "doc" ? "doc" : "overlay";

const links = await repositoryStoryLink.getStoryLinksForStory(storyId);
const acceptedLinks = links.filter((link) => link.status === "accepted");
const retiredLinks = links.filter((link) => link.status === "retired");
const inboundLinks = acceptedLinks.filter(
  (link) => link.toStory.id === storyId,
);
const outboundLinks = acceptedLinks.filter(
  (link) => link.fromStory.id === storyId,
);

const linkedStories = new Map<number, { id: number; title: string }>();
acceptedLinks.forEach((link) => {
  const other = link.fromStory.id === storyId ? link.toStory : link.fromStory;
  linkedStories.set(other.id, { id: other.id, title: other.title });
});
const linkedStoryCards = Array.from(linkedStories.values()).slice(0, 5);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>
      {i18n.t("page.site-story.meta.title", { title: story.title })}
    </title>
    <meta
      name="description"
      content={i18n.t("page.site-story.meta.description", {
        author: story.author.name,
      })}
    />
    {view !== "flat" && <ImportAFrameScripts />}
  </head>
</html>
<body>
  {
    view === "360" ? (
      <PublishedStory story={story} />
    ) : (
      <FlatStory story={story} view={view} layout={layout} />
    )
  }
  <button class="interpretive-toggle" type="button" aria-expanded="false">
    Interpretive
  </button>

  <aside class="interpretive-drawer" aria-hidden="true" hidden>
    <details>
      <summary>
        Interpretive links
        <span class="interpretive-count">
          {acceptedLinks.length}
        </span>
      </summary>
      <div class="interpretive-body">
        {acceptedLinks.length ? (
          <>
            <section>
              <h2>Outbound</h2>
              {outboundLinks.length ? (
                <ul>
                  {outboundLinks.map((link) => (
                    <li>
                      <a href={`/story/${link.toStory.id}`}>
                        {link.toStory.title}
                      </a>
                      <span class="link-meta">
                        {link.linkType}
                        {link.toScene && (
                          <span>
                            · Scene {link.toScene.title ?? `#${link.toScene.id}`}
                          </span>
                        )}
                        {link.toPageNumber && (
                          <span>· Page {link.toPageNumber}</span>
                        )}
                      </span>
                      <p class="link-rationale">{link.rationale}</p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="empty">No outbound links yet.</p>
              )}
            </section>
            <section>
              <h2>Inbound</h2>
              {inboundLinks.length ? (
                <ul>
                  {inboundLinks.map((link) => (
                    <li>
                      <a href={`/story/${link.fromStory.id}`}>
                        {link.fromStory.title}
                      </a>
                      <span class="link-meta">
                        {link.linkType}
                        {link.toScene && (
                          <span>
                            · Scene {link.toScene.title ?? `#${link.toScene.id}`}
                          </span>
                        )}
                        {link.toPageNumber && (
                          <span>· Page {link.toPageNumber}</span>
                        )}
                      </span>
                      <p class="link-rationale">{link.rationale}</p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="empty">No inbound links yet.</p>
              )}
            </section>
          </>
        ) : (
          <p class="empty">
            No accepted interpretive links yet.
          </p>
        )}
        <a
          class="interpretive-cta"
          href={`/author/story/${story.id}/links?returnTo=${encodeURIComponent(`/story/${story.id}`)}#propose`}
        >
          Propose an interpretive link
        </a>
        <a class="interpretive-cta" href="/story/vsatlatarium">
          Open VSATLATARIUM
        </a>
        {retiredLinks.length > 0 && (
          <section>
            <h2>Stewardship history</h2>
            <ul>
              {retiredLinks.map((link) => {
                const other =
                  link.fromStory.id === storyId ? link.toStory : link.fromStory;
                return (
                  <li>
                    <a href={`/story/${other.id}`}>{other.title}</a>
                    <span class="link-meta">
                      {link.linkType} · retired
                    </span>
                    <p class="link-rationale">{link.rationale}</p>
                  </li>
                );
              })}
            </ul>
          </section>
        )}
      </div>
    </details>
  </aside>

  {linkedStoryCards.length > 0 && (
    <section class="interpretive-endcap" aria-hidden="true" hidden>
      <h2>Adjacent stories</h2>
      <div class="endcap-grid">
        {linkedStoryCards.map((linked) => (
          <a class="endcap-card" href={`/story/${linked.id}`}>
            {linked.title}
          </a>
        ))}
      </div>
    </section>
  )}
</body>

<script>
  import {
    allTargetsIn,
    gazeToImagePercent,
    placeHotspot,
  } from "@components/story/published/placeHotspot";
  import { startHostController } from "@components/story/remote/hostController";
  // the flat/poster views self-host via remoteHost.ts inside FlatStory;
  // starting the A-Frame host controller too would register a second session
  if (!document.querySelector("main.flat")) {
    startHostController();
    setupGazePlacement();

    // Sneaky hop out of the photosphere: press 2 for the flat view, keeping
    // the current scene/page (and any ?room=). Bare digit because the browser
    // reserves Ctrl+digit for tab switching, but Ctrl is tolerated for
    // single-tab (kiosk/VR) contexts where it does get through.
    window.addEventListener("keydown", (e) => {
      if (e.key !== "2" || e.metaKey || e.altKey) return;
      const target = e.target as HTMLElement;
      if (
        target?.tagName === "INPUT" ||
        target?.tagName === "TEXTAREA" ||
        target?.isContentEditable
      ) {
        return;
      }
      e.preventDefault();
      const params = new URLSearchParams(location.search);
      params.set("view", "flat");
      const current = (window as any).current;
      if (current?.scene?.id) params.set("scene", String(current.scene.id));
      if (current?.page?.number != null)
        params.set("page", String(current.page.number));
      location.href = `${location.pathname}?${params.toString()}`;
    });
  }

  // Authoring-in-3D, increment A (M-authoring-3d): press "h" while looking
  // at a spot in the photosphere to place a hotspot there. The camera gaze
  // converts to the same percent-of-image coordinates the flat editor
  // writes, through the calibrated equirect mapping, and persists via the
  // same draft-insert → save → republish path.
  function setupGazePlacement() {
    let form: HTMLFormElement | null = null;
    const inputStyle =
      "font:inherit;color:#ecf0f1;background:#1b2129;border:1px solid #3c5976;border-radius:0.4rem;padding:0.35rem 0.5rem";
    const buttonStyle =
      "font:inherit;padding:0.3rem 0.8rem;border-radius:0.5rem;border:1px solid #3c5976;background:#2c3e50;color:#ecf0f1;cursor:pointer";

    window.addEventListener("keydown", (event) => {
      if (event.key !== "h" || event.metaKey || event.altKey || event.ctrlKey)
        return;
      const target = event.target as HTMLElement;
      if (
        target?.tagName === "INPUT" ||
        target?.tagName === "TEXTAREA" ||
        target?.isContentEditable
      ) {
        return;
      }
      const current = (window as any).current;
      const story = current?.story;
      const scene = current?.scene;
      const page = current?.page;
      if (!story || !scene || !page) return;
      // the title card is synthetic — nowhere to persist a hotspot
      if (!story.scenes.some((s: { id: number }) => s.id === scene.id))
        return;
      const camera = document.querySelector("a-camera") as any;
      const rotation = camera?.getAttribute("rotation");
      if (!rotation) return;
      const { x, y } = gazeToImagePercent(rotation.y, rotation.x);
      openForm(story, scene, page, x, y);
    });

    function openForm(
      story: any,
      scene: any,
      page: any,
      x: number,
      y: number,
    ) {
      form?.remove();
      form = document.createElement("form");
      form.dataset.gazeHotspotForm = "";
      form.style.cssText =
        "position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:10003;display:grid;gap:0.5rem;width:290px;padding:0.9rem 1rem;border-radius:0.75rem;background:rgba(18,21,27,0.95);border:1px solid rgba(150,170,190,0.35);color:#ecf0f1;font:0.9rem 'Source Sans Pro',system-ui,sans-serif;box-shadow:0 14px 50px rgba(0,0,0,0.5)";
      form.innerHTML = `
        <strong>Place hotspot here (${x}%, ${y}%)</strong>
        <label style="display:grid;gap:0.2rem;color:#9fb3c8">label
          <input name="label" required autocomplete="off" style="${inputStyle}" />
        </label>
        <label style="display:grid;gap:0.2rem;color:#9fb3c8">goes to
          <input name="target" list="gaze-hotspot-targets" required autocomplete="off" style="${inputStyle}" />
        </label>
        <datalist id="gaze-hotspot-targets"></datalist>
        <p data-error hidden style="margin:0;color:#e74c3c;font-size:0.8rem"></p>
        <div style="display:flex;gap:0.5rem;justify-content:flex-end">
          <button type="button" data-cancel style="${buttonStyle}">Cancel</button>
          <button type="submit" style="${buttonStyle};background:#3c5976">Place</button>
        </div>`;
      const datalist = form.querySelector("datalist")!;
      for (const t of allTargetsIn(story)) {
        const option = document.createElement("option");
        option.value = t;
        datalist.appendChild(option);
      }
      form.querySelector("[data-cancel]")!.addEventListener("click", () => {
        form?.remove();
        form = null;
      });
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form) return;
        const label = (
          form.elements.namedItem("label") as HTMLInputElement
        ).value.trim();
        const linkTarget = (
          form.elements.namedItem("target") as HTMLInputElement
        ).value.trim();
        if (!label || !linkTarget) return;
        const errorEl = form.querySelector("[data-error]") as HTMLElement;
        const submitButton = form.querySelector(
          "button[type=submit]",
        ) as HTMLButtonElement;
        submitButton.disabled = true;
        errorEl.hidden = true;
        try {
          await placeHotspot({
            storyId: story.id,
            sceneId: scene.id,
            pageNumber: page.number,
            label,
            target: linkTarget,
            x,
            y,
          });
          location.reload();
        } catch (error: any) {
          errorEl.textContent = String(error?.message ?? error);
          errorEl.hidden = false;
          submitButton.disabled = false;
        }
      });
      document.body.appendChild(form);
      (form.elements.namedItem("label") as HTMLInputElement).focus();
    }
  }
</script>

<script is:inline>
  const toggle = document.querySelector(".interpretive-toggle");
  const drawer = document.querySelector(".interpretive-drawer");
  const endcap = document.querySelector(".interpretive-endcap");
  let pinnedOpen = false;
  let peekOpen = false;

  const syncOverlay = () => {
    const isOpen = pinnedOpen || peekOpen;
    document.body.classList.toggle("interpretive-overlay--open", isOpen);
    toggle?.setAttribute("aria-expanded", String(isOpen));
    if (drawer) {
      drawer.setAttribute("aria-hidden", String(!isOpen));
      drawer.hidden = !isOpen;
    }
    if (endcap) {
      endcap.setAttribute("aria-hidden", String(!isOpen));
      endcap.hidden = !isOpen;
    }
  };

  toggle?.addEventListener("click", () => {
    pinnedOpen = !pinnedOpen;
    syncOverlay();
  });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Shift") {
      peekOpen = true;
      syncOverlay();
    }
    if (event.key.toLowerCase?.() === "i") {
      pinnedOpen = !pinnedOpen;
      syncOverlay();
    }
    if (event.key === "Escape") {
      pinnedOpen = false;
      peekOpen = false;
      syncOverlay();
    }
  });

  window.addEventListener("keyup", (event) => {
    if (event.key === "Shift") {
      peekOpen = false;
      syncOverlay();
    }
  });

  syncOverlay();
</script>

<style>
  .interpretive-drawer {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 10000;
    width: min(360px, 90vw);
    font-family: "Source Sans Pro", system-ui, sans-serif;
    pointer-events: auto;
  }

  .interpretive-toggle {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10001;
    border: 1px solid #222;
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    background: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    font-family: "Source Sans Pro", system-ui, sans-serif;
    pointer-events: auto;
  }

  .interpretive-drawer details {
    border: 1px solid #222;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.95);
    overflow: hidden;
  }

  .interpretive-drawer summary {
    cursor: pointer;
    padding: 0.6rem 0.9rem;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }

  .interpretive-drawer summary::-webkit-details-marker {
    display: none;
  }

  .interpretive-count {
    background: #1f4d7a;
    color: #fff;
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    font-size: 0.75rem;
  }

  .interpretive-body {
    padding: 0.75rem 0.9rem 1rem;
    display: grid;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .interpretive-body h2 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .interpretive-body ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
  }

  .link-meta {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  .link-rationale {
    margin-top: 0.25rem;
    font-style: italic;
  }

  .empty {
    opacity: 0.7;
    font-style: italic;
  }

  .interpretive-cta {
    border: 1px solid #1f4d7a;
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    text-decoration: none;
    color: #1f4d7a;
    background: #e7f2ff;
    text-align: center;
  }

  .interpretive-endcap {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 10000;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid #222;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem 1rem;
    font-family: "Source Sans Pro", system-ui, sans-serif;
    max-width: 480px;
    pointer-events: auto;
  }

  .interpretive-endcap h2 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .endcap-grid {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  }

  .endcap-card {
    border: 1px solid #222;
    border-radius: 0.6rem;
    padding: 0.5rem;
    text-decoration: none;
    color: inherit;
    background: #fff;
  }

  @media screen and (max-width: 720px) {
    .interpretive-drawer {
      right: 0.5rem;
      left: 0.5rem;
      width: auto;
    }

    .interpretive-toggle {
      left: 0.5rem;
    }

    .interpretive-endcap {
      left: 0.5rem;
      right: 0.5rem;
      width: auto;
    }
  }
</style>
