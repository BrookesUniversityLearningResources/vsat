---
import ImportAFrameScripts from "@components/story/published/aframe/ImportAFrameScripts.astro";
import FlatStory from "@components/story/published/flat/FlatStory.astro";
import PublishedStory from "@components/story/published/PublishedStory.astro";
import { ErrorCodes } from "@domain/error/errorCode";
import toStoryId from "@domain/story/toStoryId";

const storyId = toStoryId(Astro.params.storyId);

if (!storyId) {
  return Astro.redirect(`/author/story?err=${ErrorCodes.StoryNotFound}`);
}

const { i18n, repositoryStory, repositoryStoryLink } = Astro.locals.environment<
  App.WithI18N & App.WithStoryRepository & App.WithStoryLinkRepository
>();

const story = await repositoryStory.getPublishedStory(storyId);

if (!story) {
  return Astro.redirect(`/author/story?err=${ErrorCodes.StoryNotFound}`);
}

// How to present the scenes: ?view= overrides, otherwise the story's
// persisted mode picks the default. "flat" and "poster" render without the
// photosphere; "poster" hangs the flat photo in A-Frame space.
const requestedView = Astro.url.searchParams.get("view");
const view =
  requestedView === "flat" || requestedView === "poster"
    ? requestedView
    : requestedView === "360"
      ? "360"
      : story.mode === "2d"
        ? "flat"
        : "360";
const layout =
  Astro.url.searchParams.get("layout") === "doc" ? "doc" : "overlay";

const links = await repositoryStoryLink.getStoryLinksForStory(storyId);
const acceptedLinks = links.filter((link) => link.status === "accepted");
const retiredLinks = links.filter((link) => link.status === "retired");
const inboundLinks = acceptedLinks.filter(
  (link) => link.toStory.id === storyId,
);
const outboundLinks = acceptedLinks.filter(
  (link) => link.fromStory.id === storyId,
);

const linkedStories = new Map<number, { id: number; title: string }>();
acceptedLinks.forEach((link) => {
  const other = link.fromStory.id === storyId ? link.toStory : link.fromStory;
  linkedStories.set(other.id, { id: other.id, title: other.title });
});
const linkedStoryCards = Array.from(linkedStories.values()).slice(0, 5);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>
      {i18n.t("page.site-story.meta.title", { title: story.title })}
    </title>
    <meta
      name="description"
      content={i18n.t("page.site-story.meta.description", {
        author: story.author.name,
      })}
    />
    {view !== "flat" && <ImportAFrameScripts />}
  </head>
</html>
<body>
  {
    view === "360" ? (
      <PublishedStory story={story} />
    ) : (
      <FlatStory story={story} view={view} layout={layout} />
    )
  }
  {
    view === "360" && (
      <aside class="story-key-hint">
        <button
          class="story-key-hint__toggle"
          type="button"
          aria-label="360° keyboard controls"
          aria-expanded="false"
          aria-controls="story-key-hint-list"
          title="360° keyboard controls"
        >
          ?
        </button>
        <div id="story-key-hint-list" class="story-key-hint__panel" hidden>
          <strong>360° keys</strong>
          <dl>
            <div><dt><kbd>h</kbd></dt><dd>place link hotspot</dd></div>
            <div><dt><kbd>a</kbd></dt><dd>place audio hotspot</dd></div>
            <div><dt><kbd>⇧</kbd></dt><dd>hold to move audio marker</dd></div>
            <div><dt><kbd>m</kbd></dt><dd>move story panel</dd></div>
            <div><dt><kbd>2</kbd></dt><dd>switch to flat view</dd></div>
          </dl>
        </div>
      </aside>
    )
  }
  <button class="interpretive-toggle" type="button" aria-expanded="false">
    Interpretive
  </button>

  <aside class="interpretive-drawer" aria-hidden="true" hidden>
    <details>
      <summary>
        Interpretive links
        <span class="interpretive-count">
          {acceptedLinks.length}
        </span>
      </summary>
      <div class="interpretive-body">
        {acceptedLinks.length ? (
          <>
            <section>
              <h2>Outbound</h2>
              {outboundLinks.length ? (
                <ul>
                  {outboundLinks.map((link) => (
                    <li>
                      <a href={`/story/${link.toStory.id}`}>
                        {link.toStory.title}
                      </a>
                      <span class="link-meta">
                        {link.linkType}
                        {link.toScene && (
                          <span>
                            · Scene {link.toScene.title ?? `#${link.toScene.id}`}
                          </span>
                        )}
                        {link.toPageNumber && (
                          <span>· Page {link.toPageNumber}</span>
                        )}
                      </span>
                      <p class="link-rationale">{link.rationale}</p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="empty">No outbound links yet.</p>
              )}
            </section>
            <section>
              <h2>Inbound</h2>
              {inboundLinks.length ? (
                <ul>
                  {inboundLinks.map((link) => (
                    <li>
                      <a href={`/story/${link.fromStory.id}`}>
                        {link.fromStory.title}
                      </a>
                      <span class="link-meta">
                        {link.linkType}
                        {link.toScene && (
                          <span>
                            · Scene {link.toScene.title ?? `#${link.toScene.id}`}
                          </span>
                        )}
                        {link.toPageNumber && (
                          <span>· Page {link.toPageNumber}</span>
                        )}
                      </span>
                      <p class="link-rationale">{link.rationale}</p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="empty">No inbound links yet.</p>
              )}
            </section>
          </>
        ) : (
          <p class="empty">
            No accepted interpretive links yet.
          </p>
        )}
        <a
          class="interpretive-cta"
          href={`/author/story/${story.id}/links?returnTo=${encodeURIComponent(`/story/${story.id}`)}#propose`}
        >
          Propose an interpretive link
        </a>
        <a class="interpretive-cta" href="/story/vsatlatarium">
          Open VSATLATARIUM
        </a>
        {retiredLinks.length > 0 && (
          <section>
            <h2>Stewardship history</h2>
            <ul>
              {retiredLinks.map((link) => {
                const other =
                  link.fromStory.id === storyId ? link.toStory : link.fromStory;
                return (
                  <li>
                    <a href={`/story/${other.id}`}>{other.title}</a>
                    <span class="link-meta">
                      {link.linkType} · retired
                    </span>
                    <p class="link-rationale">{link.rationale}</p>
                  </li>
                );
              })}
            </ul>
          </section>
        )}
      </div>
    </details>
  </aside>

  {linkedStoryCards.length > 0 && (
    <section class="interpretive-endcap" aria-hidden="true" hidden>
      <h2>Adjacent stories</h2>
      <div class="endcap-grid">
        {linkedStoryCards.map((linked) => (
          <a class="endcap-card" href={`/story/${linked.id}`}>
            {linked.title}
          </a>
        ))}
      </div>
    </section>
  )}
</body>

<script>
  import {
    AUDIO_CORS_WARNING,
    allTargetsIn,
    canLoadExternalAudio,
    findAudioHotspotLine,
    gazeToImagePercent,
    imagePercentToGaze,
    moveAudioHotspotLine,
    mutateDraftContent,
    placeAudioHotspot,
    placeHotspot,
    upsertPanelLine,
  } from "@components/story/published/placeHotspot";
  import { startHostController } from "@components/story/remote/hostController";
  // the flat/poster views self-host via remoteHost.ts inside FlatStory;
  // starting the A-Frame host controller too would register a second session
  if (!document.querySelector("main.flat")) {
    startHostController();
    setupGazePlacement();
    setupKeyHint();

    // Sneaky hop out of the photosphere: press 2 for the flat view, keeping
    // the current scene/page (and any ?room=). Bare digit because the browser
    // reserves Ctrl+digit for tab switching, but Ctrl is tolerated for
    // single-tab (kiosk/VR) contexts where it does get through.
    window.addEventListener("keydown", (e) => {
      if (e.key !== "2" || e.metaKey || e.altKey) return;
      const target = e.target as HTMLElement;
      if (
        target?.tagName === "INPUT" ||
        target?.tagName === "TEXTAREA" ||
        target?.isContentEditable
      ) {
        return;
      }
      e.preventDefault();
      const params = new URLSearchParams(location.search);
      params.set("view", "flat");
      const current = (window as any).current;
      if (current?.scene?.id) params.set("scene", String(current.scene.id));
      if (current?.page?.number != null)
        params.set("page", String(current.page.number));
      location.href = `${location.pathname}?${params.toString()}`;
    });
  }

  function setupKeyHint() {
    const toggle = document.querySelector<HTMLButtonElement>(
      ".story-key-hint__toggle",
    );
    const panel = document.querySelector<HTMLElement>(
      ".story-key-hint__panel",
    );
    if (!toggle || !panel) return;

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(panel.hidden));
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }

  // Authoring-in-3D, increment A (M-authoring-3d): press "h" while looking
  // at a spot in the photosphere to place a hotspot there. The camera gaze
  // converts to the same percent-of-image coordinates the flat editor
  // writes, through the calibrated equirect mapping, and persists via the
  // same draft-insert → save → republish path.
  function setupGazePlacement() {
    let form: HTMLFormElement | null = null;
    let audioGrab: {
      entity: any;
      frame: number;
      radius: number;
      originalPosition: { x: number; y: number; z: number };
      originalRotation: { x: number; y: number; z: number };
      originalScale: { x: number; y: number; z: number };
      storyId: number;
      sceneId: number;
      pageNumber: number;
      text: string;
      x: number;
      y: number;
    } | null = null;
    const inputStyle =
      "font:inherit;color:#ecf0f1;background:#1b2129;border:1px solid #3c5976;border-radius:0.4rem;padding:0.35rem 0.5rem";
    const buttonStyle =
      "font:inherit;padding:0.3rem 0.8rem;border-radius:0.5rem;border:1px solid #3c5976;background:#2c3e50;color:#ecf0f1;cursor:pointer";

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && audioGrab) {
        event.preventDefault();
        cancelAudioGrab();
        return;
      }
      if (event.key === "Shift" && !event.repeat && !form) {
        const target = event.target as HTMLElement;
        if (
          target?.tagName !== "INPUT" &&
          target?.tagName !== "TEXTAREA" &&
          !target?.isContentEditable &&
          startAudioGrab()
        ) {
          event.preventDefault();
        }
        return;
      }
      if (
        (event.key !== "a" && event.key !== "h" && event.key !== "m") ||
        event.metaKey ||
        event.altKey ||
        event.ctrlKey
      )
        return;
      const target = event.target as HTMLElement;
      if (
        target?.tagName === "INPUT" ||
        target?.tagName === "TEXTAREA" ||
        target?.isContentEditable
      ) {
        return;
      }
      const current = (window as any).current;
      const story = current?.story;
      const scene = current?.scene;
      const page = current?.page;
      if (!story || !scene || !page) return;
      // the title card is synthetic — nowhere to persist placements
      if (!story.scenes.some((s: { id: number }) => s.id === scene.id))
        return;
      const camera = document.querySelector("a-camera") as any;
      const rotation = camera?.getAttribute("rotation");
      if (!rotation) return;
      const { x, y } = gazeToImagePercent(rotation.y, rotation.x);
      if (event.key === "h" || event.key === "a") {
        openForm(event.key === "a" ? "audio" : "link", story, scene, page, x, y);
        return;
      }
      // "m" — move the fiction panel to the gaze direction: persist the
      // @panel directive and float the card there immediately (no reload).
      moveFictionTo(x, y);
      mutateDraftContent(story.id, scene.id, (content) =>
        upsertPanelLine(content, page.number, x, y),
      ).catch((err: any) => alert(String(err?.message ?? err)));
    });

    window.addEventListener("keyup", (event) => {
      if (event.key === "Shift" && audioGrab) dropAudioGrab();
    });

    function cameraRotation(): { x: number; y: number } | null {
      const camera = document.querySelector("a-camera") as any;
      return camera?.getAttribute("rotation") ?? null;
    }

    function direction(yaw: number, pitch: number) {
      const yawRadians = (yaw * Math.PI) / 180;
      const pitchRadians = (pitch * Math.PI) / 180;
      return {
        x: -Math.sin(yawRadians) * Math.cos(pitchRadians),
        y: Math.sin(pitchRadians),
        z: -Math.cos(yawRadians) * Math.cos(pitchRadians),
      };
    }

    function angularDistance(
      first: { yaw: number; pitch: number },
      second: { yaw: number; pitch: number },
    ) {
      const a = direction(first.yaw, first.pitch);
      const b = direction(second.yaw, second.pitch);
      const dot = Math.min(1, Math.max(-1, a.x * b.x + a.y * b.y + a.z * b.z));
      return (Math.acos(dot) * 180) / Math.PI;
    }

    function startAudioGrab(): boolean {
      const current = (window as any).current;
      const story = current?.story;
      const scene = current?.scene;
      const page = current?.page;
      const rotation = cameraRotation();
      if (!story || !scene || !page || !rotation) return false;
      if (!story.scenes.some((item: { id: number }) => item.id === scene.id))
        return false;

      const blocks = page.content.filter(
        (block: any) => block.kind === "blockAudioHotspot" && block.src,
      );
      const entities = [
        ...document.querySelectorAll("#hotspots [scene-audio-hotspot]"),
      ] as any[];
      const gaze = { yaw: rotation.y, pitch: rotation.x };
      let nearest:
        | { block: any; entity: any; distance: number }
        | undefined;
      blocks.forEach((block: any, index: number) => {
        const entity = entities[index];
        if (!entity) return;
        const distance = angularDistance(
          gaze,
          imagePercentToGaze(block.x, block.y),
        );
        if (!nearest || distance < nearest.distance) {
          nearest = { block, entity, distance };
        }
      });
      if (!nearest || nearest.distance > 10) return false;

      const position = nearest.entity.getAttribute("position");
      const rotationAtStart = nearest.entity.getAttribute("rotation");
      const scale = nearest.entity.getAttribute("scale");
      audioGrab = {
        entity: nearest.entity,
        frame: 0,
        radius: Math.hypot(position.x, position.y, position.z),
        originalPosition: { ...position },
        originalRotation: { ...rotationAtStart },
        originalScale: { ...scale },
        storyId: story.id,
        sceneId: scene.id,
        pageNumber: page.number,
        text: nearest.block.text,
        x: nearest.block.x,
        y: nearest.block.y,
      };
      document.body.classList.add("audio-hotspot-grab--active");
      setGrabHint(true);
      nearest.entity.setAttribute("scale", "1.4 1.4 1.4");
      followGaze();
      return true;
    }

    function followGaze() {
      if (!audioGrab) return;
      const rotation = cameraRotation();
      if (rotation) {
        const percent = gazeToImagePercent(rotation.y, rotation.x);
        const gaze = imagePercentToGaze(percent.x, percent.y);
        const vector = direction(gaze.yaw, gaze.pitch);
        audioGrab.entity.setAttribute(
          "position",
          `${vector.x * audioGrab.radius} ${vector.y * audioGrab.radius} ${vector.z * audioGrab.radius}`,
        );
        audioGrab.entity.setAttribute("rotation", `${gaze.pitch} ${gaze.yaw} 0`);
      }
      audioGrab.frame = requestAnimationFrame(followGaze);
    }

    function finishAudioGrab(grab: NonNullable<typeof audioGrab>) {
      cancelAnimationFrame(grab.frame);
      grab.entity.setAttribute("scale", grab.originalScale);
      document.body.classList.remove("audio-hotspot-grab--active");
      setGrabHint(false);
      audioGrab = null;
    }

    function cancelAudioGrab() {
      if (!audioGrab) return;
      const grab = audioGrab;
      grab.entity.setAttribute("position", grab.originalPosition);
      grab.entity.setAttribute("rotation", grab.originalRotation);
      finishAudioGrab(grab);
    }

    function dropAudioGrab() {
      if (!audioGrab) return;
      const grab = audioGrab;
      const rotation = cameraRotation();
      if (!rotation) {
        cancelAudioGrab();
        return;
      }
      const { x, y } = gazeToImagePercent(rotation.y, rotation.x);
      finishAudioGrab(grab);
      mutateDraftContent(grab.storyId, grab.sceneId, (content) => {
        const originalRawLine = findAudioHotspotLine(
          content,
          grab.pageNumber,
          grab.text,
          grab.x,
          grab.y,
        );
        if (!originalRawLine) {
          throw new Error("couldn't find the audio hotspot in the draft");
        }
        return moveAudioHotspotLine(
          content,
          grab.pageNumber,
          originalRawLine,
          x,
          y,
        );
      })
        .then(() => location.reload())
        .catch((err: any) => {
          grab.entity.setAttribute("position", grab.originalPosition);
          grab.entity.setAttribute("rotation", grab.originalRotation);
          alert(String(err?.message ?? err));
        });
    }

    function setGrabHint(active: boolean) {
      const toggle = document.querySelector<HTMLButtonElement>(
        ".story-key-hint__toggle",
      );
      if (!toggle) return;
      toggle.textContent = active ? "release Shift to drop" : "?";
      toggle.setAttribute(
        "aria-label",
        active ? "Release Shift to drop audio marker" : "360° keyboard controls",
      );
      if (active) toggle.setAttribute("aria-expanded", "false");
      const panel = document.querySelector<HTMLElement>(
        ".story-key-hint__panel",
      );
      if (active && panel) panel.hidden = true;
    }

    function moveFictionTo(x: number, y: number) {
      const fiction = document.getElementById("fiction");
      if (!fiction) return;
      const FICTION_DISTANCE = 6.32;
      const { yaw, pitch } = imagePercentToGaze(x, y);
      const yawRadians = (yaw * Math.PI) / 180;
      const pitchRadians = (pitch * Math.PI) / 180;
      fiction.setAttribute(
        "position",
        `${-Math.sin(yawRadians) * Math.cos(pitchRadians) * FICTION_DISTANCE} ${
          Math.sin(pitchRadians) * FICTION_DISTANCE - 1.8
        } ${-Math.cos(yawRadians) * Math.cos(pitchRadians) * FICTION_DISTANCE}`,
      );
      fiction.setAttribute("rotation", `${pitch} ${yaw} 0`);
    }

    function openForm(
      kind: "link" | "audio",
      story: any,
      scene: any,
      page: any,
      x: number,
      y: number,
    ) {
      form?.remove();
      form = document.createElement("form");
      if (kind === "audio") form.dataset.gazeAudioHotspotForm = "";
      else form.dataset.gazeHotspotForm = "";
      form.style.cssText =
        "position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:10003;display:grid;gap:0.5rem;width:290px;padding:0.9rem 1rem;border-radius:0.75rem;background:rgba(18,21,27,0.95);border:1px solid rgba(150,170,190,0.35);color:#ecf0f1;font:0.9rem 'Source Sans Pro',system-ui,sans-serif;box-shadow:0 14px 50px rgba(0,0,0,0.5)";
      form.innerHTML = `
        <strong>Place ${kind === "audio" ? "audio " : ""}hotspot here (${x}%, ${y}%)</strong>
        <label style="display:grid;gap:0.2rem;color:#9fb3c8">label
          <input name="label" required autocomplete="off" style="${inputStyle}" />
        </label>
        ${
          kind === "audio"
            ? `<label style="display:grid;gap:0.2rem;color:#9fb3c8">audio URL (optional; blank uses this scene's audio)
                 <input name="audio-url" type="url" autocomplete="off" style="${inputStyle}" />
               </label>`
            : `<label style="display:grid;gap:0.2rem;color:#9fb3c8">goes to
                 <input name="target" list="gaze-hotspot-targets" required autocomplete="off" style="${inputStyle}" />
               </label>
               <datalist id="gaze-hotspot-targets"></datalist>`
        }
        <p data-error hidden style="margin:0;color:#e74c3c;font-size:0.8rem"></p>
        <div style="display:flex;gap:0.5rem;justify-content:flex-end">
          <button type="button" data-cancel style="${buttonStyle}">Cancel</button>
          <button type="submit" style="${buttonStyle};background:#3c5976">Place</button>
        </div>`;
      let verifiedOrAcceptedAudioUrl: string | null = null;
      const submitButton = form.querySelector(
        "button[type=submit]",
      ) as HTMLButtonElement;
      const audioUrlInput = form.elements.namedItem(
        "audio-url",
      ) as HTMLInputElement | null;
      audioUrlInput?.addEventListener("input", () => {
        verifiedOrAcceptedAudioUrl = null;
        submitButton.textContent = "Place";
        const errorEl = form?.querySelector("[data-error]") as HTMLElement;
        if (errorEl) errorEl.hidden = true;
      });
      const datalist = form.querySelector("datalist");
      if (datalist) {
        for (const t of allTargetsIn(story)) {
          const option = document.createElement("option");
          option.value = t;
          datalist.appendChild(option);
        }
      }
      form.querySelector("[data-cancel]")!.addEventListener("click", () => {
        form?.remove();
        form = null;
      });
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form) return;
        const label = (
          form.elements.namedItem("label") as HTMLInputElement
        ).value.trim();
        const linkTarget =
          (
            form.elements.namedItem("target") as HTMLInputElement | null
          )?.value.trim() ?? "";
        const audioUrl =
          audioUrlInput?.value.trim() ?? "";
        if (!label || (kind === "link" && !linkTarget)) return;
        const errorEl = form.querySelector("[data-error]") as HTMLElement;
        if (kind === "audio" && !audioUrl && !scene.audio) {
          errorEl.textContent =
            "This scene has no audio asset; add one or provide an audio URL.";
          errorEl.hidden = false;
          return;
        }
        if (
          kind === "audio" &&
          audioUrl &&
          verifiedOrAcceptedAudioUrl !== audioUrl
        ) {
          submitButton.disabled = true;
          errorEl.hidden = true;
          const verified = await canLoadExternalAudio(audioUrl);
          submitButton.disabled = false;
          if (!verified) {
            verifiedOrAcceptedAudioUrl = audioUrl;
            errorEl.textContent = AUDIO_CORS_WARNING;
            errorEl.hidden = false;
            submitButton.textContent = "Save anyway";
            return;
          }
        }
        submitButton.disabled = true;
        errorEl.hidden = true;
        try {
          if (kind === "audio") {
            await placeAudioHotspot({
              storyId: story.id,
              sceneId: scene.id,
              pageNumber: page.number,
              label,
              url: audioUrl,
              x,
              y,
            });
          } else {
            await placeHotspot({
              storyId: story.id,
              sceneId: scene.id,
              pageNumber: page.number,
              label,
              target: linkTarget,
              x,
              y,
            });
          }
          location.reload();
        } catch (error: any) {
          errorEl.textContent = String(error?.message ?? error);
          errorEl.hidden = false;
          submitButton.disabled = false;
        }
      });
      document.body.appendChild(form);
      (form.elements.namedItem("label") as HTMLInputElement).focus();
    }
  }
</script>

<script is:inline>
  const toggle = document.querySelector(".interpretive-toggle");
  const drawer = document.querySelector(".interpretive-drawer");
  const endcap = document.querySelector(".interpretive-endcap");
  let pinnedOpen = false;
  let peekOpen = false;
  let shiftHeld = false;

  const syncOverlay = () => {
    const isOpen = pinnedOpen || peekOpen;
    document.body.classList.toggle("interpretive-overlay--open", isOpen);
    toggle?.setAttribute("aria-expanded", String(isOpen));
    if (drawer) {
      drawer.setAttribute("aria-hidden", String(!isOpen));
      drawer.hidden = !isOpen;
    }
    if (endcap) {
      endcap.setAttribute("aria-hidden", String(!isOpen));
      endcap.hidden = !isOpen;
    }
  };

  toggle?.addEventListener("click", () => {
    pinnedOpen = !pinnedOpen;
    syncOverlay();
  });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Shift") {
      shiftHeld = true;
      requestAnimationFrame(() => {
        if (
          shiftHeld &&
          !document.body.classList.contains("audio-hotspot-grab--active")
        ) {
          peekOpen = true;
          syncOverlay();
        }
      });
    }
    if (event.key.toLowerCase?.() === "i") {
      pinnedOpen = !pinnedOpen;
      syncOverlay();
    }
    if (event.key === "Escape") {
      pinnedOpen = false;
      peekOpen = false;
      syncOverlay();
    }
  });

  window.addEventListener("keyup", (event) => {
    if (event.key === "Shift") {
      shiftHeld = false;
      peekOpen = false;
      syncOverlay();
    }
  });

  syncOverlay();
</script>

