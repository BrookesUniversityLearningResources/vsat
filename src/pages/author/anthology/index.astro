---
import Layout from "@layouts/AuthoringLayout.astro";

export const prerender = false;

const { repositoryAnthology } = Astro.locals.environment<App.WithAnthologyRepository>();

const anthologies = await repositoryAnthology.getAnthologies();
---

<Layout title="Anthologies" description="Anthology overview">
  <main class="anthology-page">
    <header class="anthology-header">
      <div>
        <p class="anthology-kicker">Anthology dashboard</p>
        <h1>Anthologies</h1>
        <p class="anthology-help">
          Curate sets of stories, then filter the planetarium by anthology.
        </p>
      </div>
      <a href="/author/story/">Back to stories</a>
    </header>

    <section class="anthology-section">
      <h2>Create an anthology</h2>
      <form id="anthology-form" class="anthology-form">
        <label>
          Title
          <input type="text" name="title" required minlength="3" />
        </label>
        <label>
          Question
          <textarea name="question" rows="4" required minlength="5"></textarea>
        </label>
        <label>
          Partner
          <input type="text" name="partner" />
        </label>
        <label>
          Status
          <select name="status">
            <option value="draft">Draft</option>
            <option value="active">Active</option>
            <option value="complete">Complete</option>
          </select>
        </label>
        <button type="submit">Create anthology</button>
        <p class="anthology-form__status" id="anthology-form-status"></p>
      </form>
    </section>

    <section class="anthology-section">
      <h2>Existing anthologies</h2>
      {anthologies.length ? (
        <ul class="anthology-list">
          {anthologies.map((anthology) => (
            <li class="anthology-card">
              <div>
                <strong>{anthology.title}</strong>
                <p>{anthology.question}</p>
              </div>
              <div class="anthology-meta">
                <span>{anthology.status}</span>
                <a href={`/author/anthology/${anthology.id}`}>Open</a>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p>No anthologies yet.</p>
      )}
    </section>
  </main>

  <script is:inline>
    const form = document.getElementById("anthology-form");
    const status = document.getElementById("anthology-form-status");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const payload = {
        title: formData.get("title"),
        question: formData.get("question"),
        partner: formData.get("partner") || undefined,
        status: formData.get("status") || undefined,
      };

      status.textContent = "Submitting...";
      const res = await fetch(`/api/anthology`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        status.textContent = "Anthology created.";
        window.location.reload();
      } else {
        status.textContent = "Failed to create anthology.";
      }
    });
  </script>
</Layout>

<style>
  .anthology-page {
    max-width: 980px;
    margin: 2rem auto;
    padding: 0 1.5rem 3rem;
  }

  .anthology-header {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .anthology-kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
  }

  .anthology-section {
    margin-top: 2rem;
  }

  .anthology-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .anthology-card {
    border: 1px solid #222;
    border-radius: 0.75rem;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .anthology-card:hover {
    border-color: #1f4d7a;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .anthology-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .anthology-meta span {
    display: inline-block;
    background: #e7f2ff;
    color: #1f4d7a;
    border: 1px solid #1f4d7a;
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .anthology-form {
    display: grid;
    gap: 1rem;
    max-width: 520px;
    background: #f9f9f9;
    padding: 1.5rem;
    border: 1px solid #ddd;
    border-radius: 0.75rem;
  }

  .anthology-form label {
    font-weight: 600;
  }

  .anthology-form textarea,
  .anthology-form input,
  .anthology-form select {
    width: 100%;
    padding: 0.5rem;
  }

  .anthology-form input:focus,
  .anthology-form select:focus,
  .anthology-form textarea:focus {
    outline: 2px solid #1f4d7a;
    outline-offset: 1px;
    border-color: #1f4d7a;
  }

  .anthology-form button[type="submit"] {
    background: #e7f2ff;
    color: #1f4d7a;
    border: 1px solid #1f4d7a;
    border-radius: 999px;
    padding: 0.5rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .anthology-form button[type="submit"]:hover {
    background: #cce3ff;
  }

  .anthology-form button[type="submit"]:focus-visible {
    outline: 2px solid #1f4d7a;
    outline-offset: 2px;
  }

  .anthology-form__status {
    font-size: 0.9rem;
  }
</style>
