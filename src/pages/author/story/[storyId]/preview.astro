---
import ImportAFrameScripts from "@components/story/published/aframe/ImportAFrameScripts.astro";
import FlatStory from "@components/story/published/flat/FlatStory.astro";
import PublishedStory from "@components/story/published/PublishedStory.astro";
import { modeForScene } from "@components/story/published/sceneView";
import { ErrorCodes } from "@domain/error/errorCode";
import { flattenPublishedStory } from "@domain/story/getPublishedStoryInDatabase";
import imageUrlFor from "@domain/story/publish/imageUrlFor";
import parseStory from "@domain/story/publish/parseStory";
import openingSceneFor from "@domain/story/publish/support/openingScene";
import toStoryId from "@domain/story/toStoryId";

const storyId = toStoryId(Astro.params.storyId);

if (!storyId) {
  return Astro.redirect(`/author/story?err=${ErrorCodes.StoryNotFound}`);
}

const { i18n, repositoryStory, getPresentationMode } = Astro.locals.environment<
  App.WithI18N & App.WithStoryRepository & App.WithPresentationMode
>();

const story = await repositoryStory.getStory({
  id: storyId,
});

if (!story) {
  return Astro.redirect(`/author/story?err=${ErrorCodes.StoryNotFound}`);
}

const parseResult = parseStory(story);

if (parseResult.kind !== "storyParsed") {
  return Astro.redirect(`/author/story?err=${ErrorCodes.UnableToPublishStory}`);
}

const presentationMode = await getPresentationMode();
const parsedStory = {
  ...parseResult.story,
  // Parsing omits presentation metadata. In 360-only mode keep existing
  // flat scenes flat in preview too, rather than putting their photos on sky.
  ...(presentationMode === "360"
    ? {
        mode: story.mode,
        scenes: parseResult.story.scenes.map((scene) => ({
          ...scene,
          mode:
            story.scenes.find((stored) => stored.id === scene.id)?.mode ??
            story.mode,
        })) as typeof parseResult.story.scenes,
      }
    : {}),
  createdAt: new Date(),
  imageUrl: imageUrlFor(story),
};

// a 2D-only deployment previews flat, as its readers will see the story
const publishedStory =
  presentationMode !== "2d" ? parsedStory : flattenPublishedStory(parsedStory);
const flatPreview =
  presentationMode === "2d" ||
  (presentationMode === "360" &&
    modeForScene(publishedStory, openingSceneFor(publishedStory)) === "2d");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>
      {i18n.t("page.preview.meta.title", { title: story.title })}
    </title>
    <meta
      name="description"
      content={i18n.t("page.preview.meta.description", {
        author: story.author.name,
      })}
    />
    {!flatPreview && <ImportAFrameScripts />}
  </head>
</html>
<body>
  {
    !flatPreview ? (
      <PublishedStory story={publishedStory} />
    ) : (
      <FlatStory story={publishedStory} view="flat" layout="overlay" />
    )
  }
</body>
